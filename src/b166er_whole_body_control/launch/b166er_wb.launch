<launch>
  <!--
  ═══════════════════════════════════════════════════════════════════════
  b166er Whole-Body Control — Launch Unificado (Fase 2)

  Grafo de nós:

    [sensores]               [estado]             [atuadores]
         |                     |                      |
  /t265/odom/sample   /b166er/robot_state    /cmd_vel → Pioneer
  /pioneer/pose               |              /b166er/arm_vel_cmd
         |                    |                      |
         └──[state_estimator]─┘          ┌──[arm_vel_integrator] (hardware)
             (IK → q_arm_est)            │  → /setpoints → Arduino
                   |                     │
          [fuzzy_wb_controller]──────────┘
            (Mamdani + J_wb)             └──[gazebo_arm_bridge] (gazebo)
                                            → /Jx_velocity_controller/command

  Modos
  ─────
    sim      : RViz + joint_state_publisher_gui (sem hardware nem Gazebo)
    hardware : drivers reais Pioneer + T265 + RV-M2 + IMU + arm_vel_integrator
    gazebo   : Gazebo + controladores ros_control + gazebo_sensor_sim + arm_vel_bridge
  ═══════════════════════════════════════════════════════════════════════
  -->

  <!-- ── Argumentos globais ──────────────────────────────────────── -->
  <arg name="mode"          default="sim"
       doc="Modo de operação: sim | hardware | gazebo"/>
  <arg name="rviz"          default="true"
       doc="Abrir RViz de monitoramento"/>
  <arg name="gui"           default="true"
       doc="Abrir janela do Gazebo (gzclient)"/>
  <arg name="rate"          default="20"
       doc="Taxa de controle do stack WB (Hz)"/>
  <arg name="rviz_config"
       default="$(find b166er_robot)/config/b166er.rviz"/>
  <arg name="ik_seed_ground_truth" default="false"
       doc="Usa /joint_states real como seed do IK do state_estimator — atalho
            só de conveniência p/ Gazebo (convergência em 0 iter), NÃO fiel ao
            robô real sem encoder. Em modo hardware o mesmo tópico hoje
            carrega ruído (state_publisher sem encoder, ver ROADMAP Fase 4) —
            nunca ligar lá. Default false: estimativa recursiva, a mesma que
            o hardware real vai ter disponível."/>

  <!-- ── Robot description ───────────────────────────────────────── -->
  <param name="use_sim_time"
         value="$(eval 'true' if arg('mode') == 'gazebo' else 'false')"/>
  <param name="robot_description"
         command="$(find xacro)/xacro
                  $(find b166er_robot)/urdf/b166er.urdf.xacro"/>

  <!-- Posturas nomeadas do braço (home recolhido, deploy) — usadas
       pelo gazebo_arm_bridge (rampa pós-warm-start e comandos de
       postura) e pela futura máquina de estados da tarefa. -->
  <rosparam file="$(find b166er_whole_body_control)/config/arm_postures.yaml"
            command="load"/>

  <node name="robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"
        output="screen"/>

  <!-- ── Modo SIMULAÇÃO CINEMÁTICA (RViz) ───────────────────────── -->
  <group if="$(eval arg('mode') == 'sim')">

    <node name="joint_state_publisher_gui"
          pkg="joint_state_publisher_gui"
          type="joint_state_publisher_gui"/>

    <node if="$(arg rviz)"
          name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

  </group>

  <!-- ── Modo HARDWARE ───────────────────────────────────────────── -->
  <group if="$(eval arg('mode') == 'hardware')">

    <include
      file="$(find b166er_robot)/launch/hardware/pioneer_hardware.launch"/>

    <include
      file="$(find b166er_robot)/launch/hardware/t265_hardware.launch"/>

    <include
      file="$(find b166er_robot)/launch/hardware/movemaster_hardware.launch"/>

    <include
      file="$(find b166er_robot)/launch/hardware/imu_hardware.launch"/>

    <node if="$(arg rviz)"
          name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

    <!-- Integra vel → posição em graus → Arduino rosserial -->
    <node name="arm_vel_integrator"
          pkg="b166er_whole_body_control"
          type="arm_vel_integrator.py"
          output="screen">
      <param name="rate"      value="$(arg rate)"/>
      <param name="goto_home" value="false"/>
    </node>

  </group>

  <!-- ── Modo GAZEBO ─────────────────────────────────────────────── -->
  <group if="$(eval arg('mode') == 'gazebo')">

    <!-- Mata joint_state_publisher_gui de sessões anteriores para não
         contaminar /joint_states com valores errados (warm-start / IK) -->
    <node name="kill_gui_zombie"
          pkg="b166er_whole_body_control"
          type="kill_gui_zombie.py"
          output="screen"/>

    <!-- Publica as 4 rodas do Pioneer a posição zero para que
         robot_state_publisher calcule o TF completo e o RViz
         exiba o modelo correto (rodas não têm transmission ros_control) -->
    <node name="pioneer_wheel_state_pub"
          pkg="b166er_whole_body_control"
          type="pioneer_wheel_state_pub.py"
          output="screen"/>

    <!-- Gazebo com o b166er completo (headless; robot_state_pub já sobe acima) -->
    <include
      file="$(find b166er_robot)/launch/simulation/b166er_gazebo.launch">
      <arg name="gui"             value="$(arg gui)"/>
      <arg name="robot_state_pub" value="false"/>
    </include>

    <!-- Controladores ros_control das juntas do braço -->
    <rosparam file="$(find b166er_whole_body_control)/config/arm_controllers.yaml"
              command="load"/>

    <!-- arm_controller_loader usa rospy.init_node(disable_rostime=True)
         para evitar o deadlock do spawner padrão aguardando /clock -->
    <node name="arm_controller_loader"
          pkg="b166er_whole_body_control"
          type="arm_controller_loader.py"
          output="screen"/>

    <!-- Simula /t265/odom/sample e /pioneer/pose a partir do Gazebo -->
    <node name="gazebo_sensor_sim"
          pkg="b166er_whole_body_control"
          type="gazebo_sensor_sim.py"
          output="screen"/>

    <!-- Roteia /b166er/arm_vel_cmd → Jx_velocity_controller/command -->
    <node name="gazebo_arm_bridge"
          pkg="b166er_whole_body_control"
          type="gazebo_arm_bridge.py"
          output="screen"/>

    <node if="$(arg rviz)"
          name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

  </group>

  <!-- ── Stack de controle whole-body (todos os modos exceto sim) ── -->
  <group unless="$(eval arg('mode') == 'sim')">

    <!-- 1 · State estimator: T265 + Pioneer → q_arm (IK sem encoders) -->
    <node name="state_estimator"
          pkg="b166er_whole_body_control"
          type="state_estimator.py"
          output="screen">
      <param name="t265_odom_topic"       value="/t265/odom/sample"/>
      <param name="pioneer_odom_topic"    value="/pioneer/pose"/>
      <param name="world_frame"           value="odom"/>
      <param name="rate"                  value="$(arg rate)"/>
      <param name="use_joint_states_seed" value="$(arg ik_seed_ground_truth)"/>
    </node>

    <!-- 1b · Monitor de inclinação (IMU) — segurança de tombamento -->
    <node name="tilt_monitor"
          pkg="b166er_whole_body_control"
          type="tilt_monitor.py"
          output="screen"/>

    <!-- 1b2 · Percepção da tag. Sobe com o STACK, não só com a missão:
         é a única forma de inspecionar o que a câmera vê fora de uma
         execução, e a imagem anotada em /b166er/tag_debug_image é o
         principal recurso de diagnóstico visual do pipeline.
           rosrun image_view image_view image:=/b166er/tag_debug_image -->
    <!-- Só na simulação: no hardware o driver da RealSense publica o
         camera_info correto sozinho. -->
    <node if="$(eval arg('mode') == 'gazebo')"
          name="fisheye_info_fixer"
          pkg="b166er_whole_body_control"
          type="fisheye_info_fixer.py"
          output="screen"/>

    <node name="apriltag_localizer"
          pkg="b166er_whole_body_control"
          type="apriltag_localizer.py"
          output="screen">
      <!-- CÂMERA DEPENDE DO MODO. /task_camera só existe no Gazebo: é uma
           câmera acrescentada ao URDF que o robô real não possui. No
           hardware a única disponível é a fisheye da própria T265, que
           usa modelo equidistante e por isso precisa de ~fisheye=true
           (ver _resolve_pnp no apriltag_localizer).

           CUIDADO COM O ALCANCE: a fisheye tem 5,4 px/grau contra 7,4 da
           simulada (mais campo, menos resolução angular). Com a tag de
           220 mm a detecção confiável cai de ~3,9 m para ~2,8 m, que é
           exatamente onde a busca acontece hoje. Na bancada, ou imprime
           em A3 (A4 só comporta 155 mm de preto) ou aproxima o ponto de
           busca com ~coarse_distance. -->
      <!-- MESMA CÂMERA NOS DOIS MODOS (2026-08-26). A simulação passou
           a ter a fisheye da T265 (wideanglecamera equidistante no
           t265_link), publicando nos mesmos tópicos do driver real.
           Assim o que se valida em simulação é o caminho que roda na
           bancada — antes a percepção era exercitada por uma câmera
           que o robô não tem. -->
      <param name="image_topic"       value="/camera/fisheye1/image_raw"/>
      <param name="camera_info_topic" value="/camera/fisheye1/camera_info"/>
      <param name="fisheye"           value="true"/>
    </node>

    <!-- 1c · Segurança por laser (Hokuyo) — distância livre à frente -->
    <node name="laser_safety"
          pkg="b166er_whole_body_control"
          type="laser_safety.py"
          output="screen"/>

    <!-- 1d · Watchdog da base — para as rodas se os comandos cessarem.
         O plugin skid_steer_drive do Gazebo NÃO tem commandTimeout e
         mantém o último /cmd_vel para sempre. Em 2026-08-27 a missão
         morreu por pkill -9 no meio de um avanço e o robô seguiu
         rolando ~420 mm até prensar a ferramenta na lâmina da chave. -->
    <node name="base_watchdog"
          pkg="b166er_whole_body_control"
          type="base_watchdog.py"
          output="screen"/>

    <!-- 2 · Fuzzy whole-body controller: Pioneer + RV-M2 como 8-DOF -->
    <node name="fuzzy_wb_controller"
          pkg="b166er_whole_body_control"
          type="fuzzy_wb_controller.py"
          output="screen">
      <param name="rate"            value="$(arg rate)"/>
      <param name="nonholonomic"    value="true"/>
      <param name="null_space_gain" value="0.3"/>
      <param name="tol_pos"         value="0.005"/>
      <param name="tol_orient"      value="0.02"/>
      <!-- Manobra girar-avançar-girar (limitação lateral, Fase 3) -->
      <param name="maneuver_enable"      value="true"/>
      <param name="heading_engage_tol"   value="0.35"/>
      <param name="heading_exit_tol"     value="0.08"/>
      <param name="align_min_planar_dist" value="0.05"/>
      <param name="align_max_duration"    value="8.0"/>
      <param name="align_k"              value="1.5"/>
    </node>

  </group>

</launch>
