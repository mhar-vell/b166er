<launch>
  <!--
  ═══════════════════════════════════════════════════════════════════════
  b166er Whole-Body Control — Launch Unificado (Fase 2)

  Grafo de nós:

    [sensores]               [estado]             [atuadores]
         |                     |                      |
  /t265/odom/sample   /b166er/robot_state    /cmd_vel → Pioneer
  /pioneer/pose               |              /b166er/arm_vel_cmd
         |                    |                      |
         └──[state_estimator]─┘          ┌──[arm_vel_integrator] (hardware)
             (IK → q_arm_est)            │  → /setpoints → Arduino
                   |                     │
          [fuzzy_wb_controller]──────────┘
            (Mamdani + J_wb)             └──[gazebo_arm_bridge] (gazebo)
                                            → /Jx_velocity_controller/command

  Modos
  ─────
    sim      : RViz + joint_state_publisher_gui (sem hardware nem Gazebo)
    hardware : drivers reais Pioneer + T265 + RV-M2 + IMU + arm_vel_integrator
    gazebo   : Gazebo + controladores ros_control + gazebo_sensor_sim + arm_vel_bridge
  ═══════════════════════════════════════════════════════════════════════
  -->

  <!-- ── Argumentos globais ──────────────────────────────────────── -->
  <arg name="mode"          default="sim"
       doc="Modo de operação: sim | hardware | gazebo"/>
  <arg name="rviz"          default="true"
       doc="Abrir RViz de monitoramento"/>
  <arg name="gui"           default="true"
       doc="Abrir janela do Gazebo (gzclient)"/>
  <arg name="rate"          default="20"
       doc="Taxa de controle do stack WB (Hz)"/>
  <arg name="rviz_config"
       default="$(find b166er_robot)/config/b166er.rviz"/>
  <!-- EXECUÇÃO DO BRAÇO (2026-10-06). O RV-M2 real não tem encoder em
       nenhuma junta: a placa só aplica sentido e PWM. Dois modos:
       · posicao (histórico): controladores de POSIÇÃO do Gazebo seguram
         a junta onde se pede — fiel à percepção, mas não à execução;
         não existe no hardware.
       · malha_aberta: velocidades por junta em /setpoints (graus/s),
         executadas por um "firmware emulado" (arm_openloop_sim, Gazebo
         com controladores de VELOCIDADE) ou pelo firmware de velocidade
         nos Arduinos; posturas viram velocidade pelo arm_joint_servo
         usando a ESTIMATIVA de junta (T265 → IK), nunca /joint_states.
         É o que o robô real tem; a missão deve ser validada aqui. -->
  <arg name="braco" default="posicao"
       doc="posicao | malha_aberta — como as juntas do braço executam comandos"/>
  <arg name="garra_dx" default="0.03"
       doc="Posição da castanha onde o dedo fixo monta, em m no eixo
            transversal do GripCube: 0.03 = garra ABERTA (histórico),
            0.0 = garra FECHADA. A garra não tem junta na simulação; o
            mesmo valor vai ao xacro (JTool) e, via B166ER_GARRA_DX, à
            kinematics.py de todos os nós deste launch. Passar o MESMO
            valor a chave_mission.launch."/>
  <env name="B166ER_GARRA_DX" value="$(arg garra_dx)"/>
  <!-- Limites do J2 por software (graus): IK, servo e Fuzzy leem via
       kinematics (B166ER_J2_MIN_DEG / _MAX_DEG). Padrão = extremos do
       modelo, com switch em cada ponta (Marco, 08 Out 2026: "por enquanto
       vamos trabalhar com estes modelos"); o pedido de "0 a 65" fica para
       quando o zero do J2 do modelo for acertado com o robô. -->
  <arg name="j2_min_deg" default="-65.0"/>
  <env name="B166ER_J2_MIN_DEG" value="$(arg j2_min_deg)"/>
  <arg name="j2_max_deg" default="65.0"/>
  <env name="B166ER_J2_MAX_DEG" value="$(arg j2_max_deg)"/>
  <!-- MASSA E CG DA BASE para o teto de tombamento (fuzzy_wb_controller,
       margem_tombamento). "Base" = tudo o que não são os cinco elos
       móveis do braço (19,7 kg no URDF): Pioneer, baterias, NUC, placas,
       sensores e a base fixa do RV-M2. Por modo, porque o robô simulado
       e o real não têm a mesma massa:
       · gazebo: 13 kg a 0,15 m, sem deslocamento em x — valores
         ajustados em 2026-09-08 contra o tombamento OBSERVADO na
         simulação (RELATORIO13); não mexer sem repetir aquela bateria.
       · hardware: medida do orientador no laboratório (2026-10-01, "a
         olho", braço recolhido com as juntas a 90°): conjunto de 60 a
         65 kg, CG a 210 mm da borda traseira da plataforma e 330 mm do
         chão. No frame do base_link (que fica 26 mm ABAIXO do chão neste
         URDF; plataforma de −0,251 a +0,257 m em x): CG total em
         x = −0,041, z = 0,356. Descontando o braço a 90° pelo modelo
         (19,7 kg em x +0,171, z +0,828), com 62,5 kg: base de 42,8 kg
         em x = −0,139, z = +0,139. Entre 60 e 65 kg a base varia de
         40,3 a 45,3 kg e o CG de 0,125 a 0,151 m — diferença de margem
         < 5 %. Com isso a margem real fica em ~6 m/s² em todas as
         posturas (a_hi 1,2 não limita): é a estimativa do orientador,
         não uma pesagem; conferir na bancada com o teste de inclinação
         antes de confiar. -->
  <arg name="base_massa" default="$(eval 42.8 if arg('mode') == 'hardware' else 13.0)"/>
  <arg name="base_cg_z"  default="$(eval 0.139 if arg('mode') == 'hardware' else 0.15)"/>
  <arg name="base_cg_x"  default="$(eval -0.139 if arg('mode') == 'hardware' else 0.0)"/>
  <arg name="ik_seed_ground_truth" default="false"
       doc="Usa /joint_states real como seed do IK do state_estimator — atalho
            só de conveniência p/ Gazebo (convergência em 0 iter), NÃO fiel ao
            robô real sem encoder. Em modo hardware o mesmo tópico hoje
            carrega ruído (state_publisher sem encoder, ver ROADMAP Fase 4) —
            nunca ligar lá. Default false: estimativa recursiva, a mesma que
            o hardware real vai ter disponível."/>

  <!-- ── Robot description ───────────────────────────────────────── -->
  <param name="use_sim_time"
         value="$(eval 'true' if arg('mode') == 'gazebo' else 'false')"/>
  <arg name="arm_iface" default="position"
       doc="position | velocity — interface ros_control das juntas; velocity só para diagnóstico (ver abaixo)"/>
  <param name="robot_description"
         command="$(find xacro)/xacro
                  $(find b166er_robot)/urdf/b166er.urdf.xacro
                  garra_dx:=$(arg garra_dx) arm_iface:=$(arg arm_iface)"/>

  <!-- Posturas nomeadas do braço (home recolhido, deploy) — usadas
       pelo gazebo_arm_bridge (rampa pós-warm-start e comandos de
       postura) e pela futura máquina de estados da tarefa. -->
  <rosparam file="$(find b166er_whole_body_control)/config/arm_postures.yaml"
            command="load"/>
  <!-- Fins de curso por junta e homing (braco:=malha_aberta): a única
       referência absoluta de junta do braço sem encoder. Posições a medir
       na bancada; ver o yaml. -->
  <rosparam file="$(find b166er_whole_body_control)/config/arm_switches.yaml"
            command="load" ns="arm_switches"/>
  <!-- homing:=true leva J2/J3/J4 aos switches ao ligar (modo malha_aberta) -->
  <arg name="homing" default="true"/>

  <node name="robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"
        output="screen"/>

  <!-- ── Modo SIMULAÇÃO CINEMÁTICA (RViz) ───────────────────────── -->
  <group if="$(eval arg('mode') == 'sim')">

    <node name="joint_state_publisher_gui"
          pkg="joint_state_publisher_gui"
          type="joint_state_publisher_gui"/>

    <node if="$(arg rviz)"
          name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

  </group>

  <!-- ── Modo HARDWARE ───────────────────────────────────────────── -->
  <group if="$(eval arg('mode') == 'hardware')">

    <include
      file="$(find b166er_robot)/launch/hardware/pioneer_hardware.launch"/>

    <include
      file="$(find b166er_robot)/launch/hardware/t265_hardware.launch"/>

    <include
      file="$(find b166er_robot)/launch/hardware/movemaster_hardware.launch"/>

    <include
      file="$(find b166er_robot)/launch/hardware/imu_hardware.launch"/>

    <!-- Hokuyo UST-05LX (ethernet, 192.168.0.10) → /pioneer3at/laser_hokuyo/scan,
         o mesmo tópico do laser simulado; é o que o laser_safety lê. -->
    <include
      file="$(find b166er_robot)/launch/hardware/hokuyo_hardware.launch"/>

    <node if="$(arg rviz)"
          name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

    <!-- braco:=posicao — integra vel → posição em graus → Arduino rosserial
         (pressupõe firmware de posição, que exige encoder: NÃO é o caso
         deste braço; mantido só por compatibilidade) -->
    <node unless="$(eval arg('braco') == 'malha_aberta')"
          name="arm_vel_integrator"
          pkg="b166er_whole_body_control"
          type="arm_vel_integrator.py"
          output="screen">
      <param name="rate"      value="$(arg rate)"/>
      <param name="goto_home" value="false"/>
    </node>
    <!-- braco:=malha_aberta — velocidades em graus/s para o firmware de
         velocidade dos Arduinos; posturas pela estimativa da T265 -->
    <node if="$(eval arg('braco') == 'malha_aberta')"
          name="arm_joint_servo"
          pkg="b166er_whole_body_control"
          type="arm_joint_servo.py"
          output="screen">
      <param name="rate" value="$(arg rate)"/>
      <param name="goto_home_on_start" value="false"/>
      <param name="homing_on_start" value="$(arg homing)"/>
    </node>

  </group>

  <!-- ── Modo GAZEBO ─────────────────────────────────────────────── -->
  <group if="$(eval arg('mode') == 'gazebo')">

    <!-- Mata joint_state_publisher_gui de sessões anteriores para não
         contaminar /joint_states com valores errados (warm-start / IK) -->
    <node name="kill_gui_zombie"
          pkg="b166er_whole_body_control"
          type="kill_gui_zombie.py"
          output="screen"/>

    <!-- Publica as 4 rodas do Pioneer a posição zero para que
         robot_state_publisher calcule o TF completo e o RViz
         exiba o modelo correto (rodas não têm transmission ros_control) -->
    <node name="pioneer_wheel_state_pub"
          pkg="b166er_whole_body_control"
          type="pioneer_wheel_state_pub.py"
          output="screen"/>

    <!-- Gazebo com o b166er completo (headless; robot_state_pub já sobe acima) -->
    <include
      file="$(find b166er_robot)/launch/simulation/b166er_gazebo.launch">
      <arg name="gui"             value="$(arg gui)"/>
      <arg name="robot_state_pub" value="false"/>
      <arg name="garra_dx"        value="$(arg garra_dx)"/>
      <arg name="arm_iface"       value="$(arg arm_iface)"/>
    </include>

    <!-- Controladores ros_control das juntas do braço: posição (histórico)
         ou velocidade (braco:=malha_aberta, ver arm_controllers_vel.yaml) -->
    <!-- 2026-10-07: no modo malha_aberta o firmware emulado passou a
         INTEGRAR a velocidade pedida num setpoint de POSIÇÃO (ver
         arm_openloop_sim.py, ~saida): a leitura de velocidade de junta do
         Gazebo/ODE sob carga não bate com Δposição/Δt (J2 subindo a
         1,5 °/s com o controlador "vendo" 5 °/s) e os controladores de
         velocidade andavam devagar. Controladores de velocidade só com
         arm_iface:=velocity (fica para diagnóstico). -->
    <rosparam if="$(eval arg('arm_iface') == 'velocity')"
              file="$(find b166er_whole_body_control)/config/arm_controllers_vel.yaml"
              command="load"/>
    <rosparam unless="$(eval arg('arm_iface') == 'velocity')"
              file="$(find b166er_whole_body_control)/config/arm_controllers.yaml"
              command="load"/>

    <!-- arm_controller_loader usa rospy.init_node(disable_rostime=True)
         para evitar o deadlock do spawner padrão aguardando /clock -->
    <node name="arm_controller_loader"
          pkg="b166er_whole_body_control"
          type="arm_controller_loader.py"
          output="screen">
      <rosparam if="$(eval arg('arm_iface') == 'velocity')" param="controllers">
        [joint_state_controller, J1_velocity_controller, J2_velocity_controller,
         J3_velocity_controller, J4_velocity_controller, J5_velocity_controller]
      </rosparam>
    </node>

    <!-- Simula /t265/odom/sample e /pioneer/pose a partir do Gazebo -->
    <node name="gazebo_sensor_sim"
          pkg="b166er_whole_body_control"
          type="gazebo_sensor_sim.py"
          output="screen"/>

    <!-- braco:=posicao — ponte histórica: integra vel → posição e comanda
         os controladores de POSIÇÃO do Gazebo -->
    <node unless="$(eval arg('braco') == 'malha_aberta')"
          name="gazebo_arm_bridge"
          pkg="b166er_whole_body_control"
          type="gazebo_arm_bridge.py"
          output="screen"/>
    <!-- braco:=malha_aberta — firmware emulado (velocidade por junta, zona
         morta, watchdog) + executor de posturas pela estimativa -->
    <node if="$(eval arg('braco') == 'malha_aberta')"
          name="arm_openloop_sim"
          pkg="b166er_whole_body_control"
          type="arm_openloop_sim.py"
          output="screen">
      <param name="saida" value="$(eval 'velocidade' if arg('arm_iface') == 'velocity' else 'posicao')"/>
    </node>
    <node if="$(eval arg('braco') == 'malha_aberta')"
          name="arm_joint_servo"
          pkg="b166er_whole_body_control"
          type="arm_joint_servo.py"
          output="screen">
      <param name="rate" value="$(arg rate)"/>
      <param name="homing_on_start" value="$(arg homing)"/>
    </node>

    <node if="$(arg rviz)"
          name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

  </group>

  <!-- ── Stack de controle whole-body (todos os modos exceto sim) ── -->
  <group unless="$(eval arg('mode') == 'sim')">

    <!-- 1 · State estimator: T265 + Pioneer → q_arm (IK sem encoders) -->
    <node name="state_estimator"
          pkg="b166er_whole_body_control"
          type="state_estimator.py"
          output="screen">
      <param name="t265_odom_topic"       value="/t265/odom/sample"/>
      <param name="pioneer_odom_topic"    value="/pioneer/pose"/>
      <param name="world_frame"           value="odom"/>
      <param name="rate"                  value="$(arg rate)"/>
      <param name="use_joint_states_seed" value="$(arg ik_seed_ground_truth)"/>
    </node>

    <!-- 1b · Monitor de inclinação (IMU) — segurança de tombamento -->
    <node name="tilt_monitor"
          pkg="b166er_whole_body_control"
          type="tilt_monitor.py"
          output="screen"/>

    <!-- 1b2 · Percepção da tag. Sobe com o STACK, não só com a missão:
         é a única forma de inspecionar o que a câmera vê fora de uma
         execução, e a imagem anotada em /b166er/tag_debug_image é o
         principal recurso de diagnóstico visual do pipeline.
           rosrun image_view image_view image:=/b166er/tag_debug_image -->
    <!-- Só na simulação: no hardware o driver da RealSense publica o
         camera_info correto sozinho. -->
    <node if="$(eval arg('mode') == 'gazebo')"
          name="fisheye_info_fixer"
          pkg="b166er_whole_body_control"
          type="fisheye_info_fixer.py"
          output="screen"/>

    <node name="apriltag_localizer"
          pkg="b166er_whole_body_control"
          type="apriltag_localizer.py"
          output="screen">
      <!-- CÂMERA DEPENDE DO MODO. /task_camera só existe no Gazebo: é uma
           câmera acrescentada ao URDF que o robô real não possui. No
           hardware a única disponível é a fisheye da própria T265, que
           usa modelo equidistante e por isso precisa de ~fisheye=true
           (ver _resolve_pnp no apriltag_localizer).

           CUIDADO COM O ALCANCE: a fisheye tem 5,4 px/grau contra 7,4 da
           simulada (mais campo, menos resolução angular). Com a tag de
           220 mm a detecção confiável cai de ~3,9 m para ~2,8 m, que é
           exatamente onde a busca acontece hoje. Na bancada, ou imprime
           em A3 (A4 só comporta 155 mm de preto) ou aproxima o ponto de
           busca com ~coarse_distance. -->
      <!-- MESMA CÂMERA NOS DOIS MODOS (2026-08-26). A simulação passou
           a ter a fisheye da T265 (wideanglecamera equidistante no
           t265_link), publicando nos mesmos tópicos do driver real.
           Assim o que se valida em simulação é o caminho que roda na
           bancada — antes a percepção era exercitada por uma câmera
           que o robô não tem. -->
      <param name="image_topic"       value="/camera/fisheye1/image_raw"/>
      <param name="camera_info_topic" value="/camera/fisheye1/camera_info"/>
      <param name="fisheye"           value="true"/>

      <!-- TAMANHO EFETIVO DA TAG NA SIMULAÇÃO — 130,2 mm, não 132.
           O quadrado preto renderizado mede 132 mm, mas o detector
           enxerga as bordas ~1,4% para dentro (antialiasing/mipmap da
           textura: o canto é achado no ponto de 50% de intensidade, que
           cai meio pixel dentro do preto de cada lado).

           Medido em 2026-08-27, depois de corrigir o ponto principal, o
           erro de PROFUNDIDADE da pose da parede era proporcional à
           distância, que é a assinatura de escala e não de offset:

             1,60 m -> +22 mm  (1,38%)
             1,30 m -> +18 mm  (1,40%)
             1,00 m -> +15 mm  (1,51%)

           132 / 1,014 = 130,2 mm.

           FICA NO LAUNCH, NÃO NO CÓDIGO. O default de TAG_SIZE segue
           0,132 — que é a tag FÍSICA do Marco. Este número corrige um
           artefato do renderizador do Gazebo e não vale na bancada, onde
           a T265 real tem o viés dela (medido em +5 a +8 cm, de outra
           natureza; ver a caracterização de 2026-08-26). Enterrar isto
           no código faria a simulação mentir sobre o hardware. -->
      <param name="tag_size"          value="0.1302"/>
    </node>

    <!-- 1c · Segurança por laser (Hokuyo) — distância livre à frente -->
    <node name="laser_safety"
          pkg="b166er_whole_body_control"
          type="laser_safety.py"
          output="screen"/>

    <!-- 1d · Watchdog da base — para as rodas se os comandos cessarem.
         O plugin skid_steer_drive do Gazebo NÃO tem commandTimeout e
         mantém o último /cmd_vel para sempre. Em 2026-08-27 a missão
         morreu por pkill -9 no meio de um avanço e o robô seguiu
         rolando ~420 mm até prensar a ferramenta na lâmina da chave. -->
    <node name="base_watchdog"
          pkg="b166er_whole_body_control"
          type="base_watchdog.py"
          output="screen"/>

    <!-- 2 · Fuzzy whole-body controller: Pioneer + RV-M2 como 8-DOF -->
    <node name="fuzzy_wb_controller"
          pkg="b166er_whole_body_control"
          type="fuzzy_wb_controller.py"
          output="screen">
      <param name="rate"            value="$(arg rate)"/>
      <param name="nonholonomic"    value="true"/>
      <param name="null_space_gain" value="0.3"/>
      <!-- tol_pos é a banda em que o controlador PARA de empurrar
           (histerese: volta a agir acima de 1,5x). Quem decide se a
           fase fechou é a MISSÃO, com a régua por eixo da fase (4-15 mm,
           chave_seccionadora_task.yaml); o controlador precisa continuar
           servindo abaixo dessa régua, senão a fase mais apertada
           (destrava, 4 mm em altura) nunca fecha. Era 5 mm; 2 mm desde
           2026-09-03. Lido uma vez, no início: mudar aqui exige subir o
           stack de novo. -->
      <param name="tol_pos"         value="0.002"/>
      <param name="tol_orient"      value="0.02"/>
      <!-- Manobra girar-avançar-girar (limitação lateral, Fase 3) -->
      <param name="maneuver_enable"      value="true"/>
      <param name="heading_engage_tol"   value="0.35"/>
      <param name="heading_exit_tol"     value="0.08"/>
      <!-- 0,05 → 0,90 m (2026-09-03, bateria de aproximação de longe).
           O rumo de referência da manobra é a direção da base ao ponto
           XY do ALVO DO EE — que fica ~0,5-0,8 m à frente/ao lado da base
           quando ela já está onde deve. Com o piso em 5 cm, no último
           metro esse rumo gira a cada avanço e o estado entra e sai de
           ALIGN 14-21 vezes por execução (limiar de 0,35 rad cruzado sem
           parar): o robô chega a 11-20 mm do alvo e nunca se estabiliza.
           Abaixo do alcance do braço a manobra não faz sentido — o DLS
           holonômico resolve o resto — então o piso passa a ~alcance
           + margem. -->
      <param name="align_min_planar_dist" value="0.90"/>
      <param name="align_max_duration"    value="8.0"/>
      <param name="align_k"              value="1.5"/>
      <!-- Teto de velocidade DEPENDENTE DA POSTURA (2026-09-08). O robô
           tombou a 0,3 m/s com o braço na postura de busca e passou com
           o braço recolhido: a margem quase-estática de tombamento
           (aceleração que leva a resultante ao eixo dianteiro) é
           1,42 m/s² em travel, 0,92 em search e 0,51 em deploy. O
           controlador recalcula essa margem a cada ciclo pela postura
           medida e (1) limita a variação de /cmd_vel a seguranca×margem,
           (2) escala o teto de velocidade entre a_lo e a_hi (pertinência
           linear, mínimo s_min). Relido a cada wb_enable: a bateria
           desliga com rosparam set .../teto_postura/enable false. -->
      <rosparam param="teto_postura" subst_value="true">
        enable: true
        a_lo: 0.5
        a_hi: 1.2
        s_min: 0.3
        seguranca: 0.5
        base_massa: $(arg base_massa)
        base_cg_z: $(arg base_cg_z)
        base_cg_x: $(arg base_cg_x)
      </rosparam>
    </node>

  </group>

</launch>
