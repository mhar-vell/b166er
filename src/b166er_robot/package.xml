<?xml version="1.0"?>
<package format="2">
  <name>b166er_robot</name>
  <version>1.0.0</version>
  <description>B1-66ER robot simulation and control package</description>
  
  <maintainer email="marcoreis@alunos.utfpr.edu.br">Marco Reis</maintainer>
  <license>MIT</license>
  
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>tf2_ros</build_depend>
  
  <exec_depend>tf2_ros</exec_depend>
  
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_ros_control</depend>
  <depend>rosaria</depend>
  <depend>movemaster_control</depend>

  <export>
    <!-- Expõe materials/ como caminho de mídia do Gazebo, para que o
         script apriltag.material (materials/scripts/) e a textura
         apriltag_36h11_id0.png (materials/textures/) sejam encontrados
         pelo suporte de AprilTag em urdf/fixtures/apriltag_mount.urdf.xacro. -->
    <gazebo_ros gazebo_media_path="${prefix}"/>
  </export>
</package>