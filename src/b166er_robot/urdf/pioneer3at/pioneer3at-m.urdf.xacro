<?xml version="1.0"?>
<robot xmlns:sensor="http://playerstage.sourceforge.net/gazebo/xmlschema/#sensor" xmlns:controller="http://playerstage.sourceforge.net/gazebo/xmlschema/#controller" xmlns:interface="http://playerstage.sourceforge.net/gazebo/xmlschema/#interface" xmlns:xacro="http://ros.org/wiki/xacro" name="pioneer3at">

  <xacro:property name="PI" value="3.141592654" />
  <xacro:property name="robot_name" value="pioneer3at" />


  <!-- Chassis -->
  <link name="base_link">
    <!--  For pointers on inertial and gazebo-related parameters see
		       * http://wiki.ros.org/urdf/Tutorials/Adding%20Physical%20and%20Collision%20Properties%20to%20a%20URDF%20Model
                       * http://answers.gazebosim.org/question/4372/the-inertia-matrix-explained/
		       * http://gazebosim.org/tutorials?tut=inertia&cat=build_robot, and
                       * http://gazebosim.org/tutorials/?tut=ros_urdf
                       * http://en.wikipedia.org/wiki/List_of_moment_of_inertia_tensors
                -->
    <inertial>
      <mass value="21"/>
      <!-- P3AT 18.6kg plus three batteries @ 2.4kg each  minus four wheels @ 1.4 kg ea and top plate @ 0.1 kg-->
      <origin xyz="0 0 0.177"/>
      <!--inertia ixx="0.3338" ixy="0.0" ixz="0.0" iyy="0.4783" iyz="0.0" izz="0.3338"/-->
      <inertia ixx="0.147116667" ixy="0.0" ixz="0.0" iyy="0.334951167" iyz="0.0" izz="0.3978345"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.177" rpy="0 0 0"/>
      <geometry name="pioneer_geom">
        <mesh filename="package://b166er_robot/meshes/pioneer3at/chassis.stl"/>
      </geometry>
      <material name="ChassisRed">
        <color rgba="0.851 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.177" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://b166er_robot/meshes/pioneer3at/chassis.stl"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="base_link">
    <material value="Gazebo/Red"/>
    <sensor name="blc" type='contact'>
        <contact>
        <collision>base_link_collision</collision>
        </contact>
    </sensor>
  </gazebo>
  <!-- Top -->
  <link name="top_plate">
    <!--inertial>
			<mass value="0.1"/>
			<origin xyz="-0.025 0 -0.223"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0"
				 iyy="0.01" iyz="0.0"
 				izz="0.01"/>
		</inertial-->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry name="pioneer_geom">
        <mesh filename="package://b166er_robot/meshes/pioneer3at/top.stl"/>
      </geometry>
      <material name="TopBlack">
        <color rgba="0.038 0.038 0.038 1.0"/>
      </material>
    </visual>
  </link>
  <gazebo reference="top_plate">
    <material>Gazebo/Black</material>
    <sensor name="tpc" type='contact'>
        <contact>
        <collision>top_plate_collision</collision>
        </contact>
    </sensor>
  </gazebo>
  <joint name="base_top_joint" type="fixed">
    <origin xyz="0.003 0 0.274" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="top_plate"/>
  </joint>
  <!-- Front + Back Sonar -->
  <link name="front_sonar">
    <!--inertial>
			<mass value="0.1"/>
			<origin xyz="0 0 0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0"
				 iyy="0.01" iyz="0.0" izz="0.01"/>
		</inertial-->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry name="pioneer_geom">
        <mesh filename="package://b166er_robot/meshes/pioneer3at/front_sonar.stl"/>
      </geometry>
      <material name="SonarYellow">
        <color rgba="0.715 0.583 0.210 1.0"/>
      </material>
    </visual>
  </link>
  <gazebo reference="front_sonar">
    <material value="Gazebo/Yellow"/>
  </gazebo>
  <joint name="base_front_joint" type="fixed">
    <origin xyz="0.193 0 0.25" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_sonar"/>
  </joint>
  <link name="back_sonar">
    <!--inertial>
			<mass value="0.1"/>
			<origin xyz="0 0 0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0"
				 iyy="0.01" iyz="0.0" izz="0.01"/>
		</inertial-->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry name="pioneer_geom">
        <mesh filename="package://b166er_robot/meshes/pioneer3at/back_sonar.stl"/>
      </geometry>
      <material name="SonarYellow">
        <color rgba="0.715 0.583 0.210 1.0"/>
      </material>
    </visual>
  </link>
  <gazebo reference="back_sonar">
    <material value="Gazebo/Yellow"/>
  </gazebo>
  <joint name="base_back_joint" type="fixed">
    <origin xyz="-0.187 0 0.247" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_sonar"/>
  </joint>
  <xacro:macro name="p3at_drive_side" params="side reflect">
    <!-- Front Axles + Wheels + Hubcaps -->
    <link name="p3at_front_${side}_axle">
      <!--inertial>
			<mass value="0.1"/>
			<origin xyz="0 0 0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0"
				 iyy="0.01" iyz="0.0" izz="0.01"/>
  	 	</inertial-->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry name="pioneer_geom">
          <mesh filename="package://b166er_robot/meshes/pioneer3at/axle.stl"/>
        </geometry>
        <material name="AxleGrey">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
    </link>
    <gazebo reference="p3at_front_${side}_axle">
      <material value="Gazebo/Grey"/>
    </gazebo>
    <joint name="base_front_${side}_axle_joint" type="fixed">
      <origin xyz="0.135 ${reflect*0.156} 0.111" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="p3at_front_${side}_axle"/>
    </joint>
    <link name="p3at_front_${side}_hub">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry name="pioneer_geom">
          <mesh filename="package://b166er_robot/meshes/pioneer3at/${side}_hubcap.stl"/>
        </geometry>
        <material name="HubcapYellow">
          <color rgba="1.0 0.811 0.151 1.0"/>
        </material>
      </visual>
    </link>
    <gazebo reference="p3at_front_${side}_hub">
      <material value="Gazebo/Yellow"/>
    </gazebo>
    <joint name="base_front_${side}_hub_joint" type="fixed">
      <origin xyz="0 ${reflect*0.041} 0" rpy="0 0 0"/>
      <parent link="p3at_front_${side}_axle"/>
      <child link="p3at_front_${side}_hub"/>
    </joint>
    <link name="p3at_front_${side}_wheel">
      <inertial>
        <!-- 1.4 kg - axle 0.1 kg - hub 0.1 kg -->
        <!--mass value="1.2"/>
			<origin xyz="0 0 0"/>
			<inertia ixx="0.012411765597" ixy="0" ixz="0"
         iyy="0.015218160428" iyz="0" izz="0.011763977943"/-->
        <mass value="1.1"/>
        <origin xyz="0 0 0"/>
        <!--inertia ixx="0.005240625" ixy="0" ixz="0" iyy="0.009075" iyz="0" izz="0.005240625"/-->
        <inertia ixx="0.002216042" ixy="0" ixz="0" iyy="0.00397375" iyz="0" izz="0.002216042"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry name="pioneer_geom">
          <mesh filename="package://b166er_robot/meshes/pioneer3at/wheel.stl" scale="0.75 0.66 0.75"/>
        </geometry>
        <material name="WheelBlack">
          <color rgba="0.117 0.117 0.117 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-3.1415927/2} 0 0"/>
        <geometry>
          <!--mesh filename="package://b166er_robot/meshes/pioneer3at/wheel.stl"/-->
          <cylinder radius="0.085" length="0.05"/>
        </geometry>
      </collision>
    </link>

    <!-- Parâmetros de contato ficam no bloco único mais abaixo (junto do
         sensor de contato) — blocos <gazebo reference> duplicados para o
         mesmo link conflitam na fusão do SDF. -->
    <joint name="p3at_front_${side}_wheel_joint" type="continuous">
      <axis xyz="0 1 0"/>
      <anchor xyz="0 0 0"/>
      <limit effort="10" velocity="10"/>
      <dynamics damping="1.0" friction="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="p3at_front_${side}_hub"/>
      <child link="p3at_front_${side}_wheel"/>
    </joint>
    <!-- Back Axles + Wheels + Hubcaps -->
    <link name="p3at_back_${side}_axle">
      <!--inertial>
			<mass value="0.1"/>
			<origin xyz="0 0 0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0"
				 iyy="0.01" iyz="0.0" izz="0.01"/>
  	 	</inertial-->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry name="pioneer_geom">
          <mesh filename="package://b166er_robot/meshes/pioneer3at/axle.stl"/>
        </geometry>
        <material name="AxleGrey">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://b166er_robot/meshes/pioneer3at/axle.stl"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="p3at_back_${side}_axle">
      <material value="Gazebo/Grey"/>
    </gazebo>
    <joint name="p3at_back_${side}_axle_joint" type="fixed">
      <origin xyz="-0.134 ${reflect*0.156} 0.111" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="p3at_back_${side}_axle"/>
    </joint>
    <link name="p3at_back_${side}_hub">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry name="pioneer_geom">
          <mesh filename="package://b166er_robot/meshes/pioneer3at/${side}_hubcap.stl"/>
        </geometry>
        <material name="HubcapYellow">
          <color rgba="1.0 0.811 0.151 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://b166er_robot/meshes/pioneer3at/${side}_hubcap.stl"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="p3at_back_${side}_hub">
      <material value="Gazebo/Yellow"/>
    </gazebo>
    <joint name="p3at_back_${side}_hub_joint" type="fixed">
      <origin xyz="-0 ${reflect*0.041} 0" rpy="0 0 0"/>
      <parent link="p3at_back_${side}_axle"/>
      <child link="p3at_back_${side}_hub"/>
    </joint>
    <link name="p3at_back_${side}_wheel">
      <inertial>
        <!--mass value="1.2"/>
  			<origin xyz="0 0 0"/>
  			<inertia ixx="0.012411765597" ixy="0" ixz="0"
                                                        iyy="0.015218160428" iyz="0"
                                                                             izz="0.011763977943"/-->
        <mass value="1.1"/>
        <origin xyz="0 0 0"/>
        <!--inertia ixx="0.005240625" ixy="0" ixz="0" iyy="0.009075" iyz="0" izz="0.005240625"/-->
        <inertia ixx="0.002216042" ixy="0" ixz="0" iyy="0.00397375" iyz="0" izz="0.002216042"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry name="pioneer_geom">
          <mesh filename="package://b166er_robot/meshes/pioneer3at/wheel.stl" scale="0.75 0.66 0.75"/>
        </geometry>
        <material name="WheelBlack">
          <color rgba="0.117 0.117 0.117 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-3.1415927/2} 0 0"/>
        <geometry>
          <!--mesh filename="package://b166er_robot/meshes/pioneer3at/wheel.stl"/-->
          <cylinder radius="0.085" length="0.05"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="p3at_back_${side}_wheel">
      <material value="Gazebo/Black"/>
    </gazebo>

    <joint name="p3at_back_${side}_wheel_joint" type="continuous">
      <axis xyz="0 1 0"/>
      <anchor xyz="0 0 0"/>
      <limit effort="10" velocity="10"/>
      <dynamics damping="1.0" friction="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="p3at_back_${side}_hub"/>
      <child link="p3at_back_${side}_wheel"/>
    </joint>
    <!-- see http://gazebosim.org/tutorials/?tut=ros_urdf -->
    <gazebo reference="p3at_back_${side}_wheel">
        <sensor name="cb_${side}" type='contact'>
          <contact>
            <collision>p3at_back_${side}_wheel_collision</collision>
          </contact>
        </sensor>
        <kp>1000000.0</kp>
        <!-- kd=100 dava razão de amortecimento ~1.6% para os ~41 kg do robô
             (kd crítico ≈ 6300): o contato quicava a ~50 Hz sem dissipar e a
             vibração era retificada pelo braço em deslocamento contínuo do
             chassi (~20-30 mm/s). kd=1e4 → ζ≈1.6 (levemente sobreamortecido). -->
        <kd>10000.0</kd>
        <mu1>0.9</mu1>
        <!-- was 10 -->
        <mu2>0.9</mu2>
        <!-- how to get these into <surface><friction><ode>... ?
          slip1 0.5 /slip1
           slip2 0 /slip2
        -->
        <!-- fdir1 DECLARADO (2026-09-02). Estava comentado, e sem ele o ODE
             escolhe a direção da pirâmide de atrito a cada contato entre o
             cilindro da roda e o plano; o resíduo dessas escolhas é
             retificado num avanço constante — 2,6 mm/s com o robô parado
             e cmd_vel em zero, medido em 01 e 02/09 (atrito de junta e
             taxa do plugin não mudaram nada). A direção é expressa no
             frame da COLISÃO; o cilindro é girado -90° em X, então a
             lateral (eixo do rolamento) podia ser "0 1 0" ou "0 0 1" —
             decidido por MEDIÇÃO (robô parado, 20 s de assentamento,
             janelas de 10 s, deslocamento pela verdade do Gazebo):

               sem fdir1        2,58 mm/s  (25,8 mm em 10 s)
               fdir1 0 0 1      2,57 / 2,58 mm/s — zero efeito
               fdir1 0 1 0      0,98 -> 0,60 -> 0,05 -> 0,01 mm/s
                                (cauda do pouso do spawn decaindo; em
                                 regime, 0,1-0,5 mm em 10 s)

             As rodas continuam girando ~0,04 rad/s no lugar (o motor de
             velocidade do plugin não segura zero exatamente), mas o
             contato deixou de transformar isso em avanço do corpo. A
             odometria da missão vem do gazebo_sensor_sim (verdade), não
             do plugin, então o giro residual não contamina nada. A
             vibração vertical do contato é nula (1 µm pico-a-pico) — a
             hipótese de "vibração retificada" não explica o resíduo. -->
        <fdir1>0 1 0</fdir1>
        <!-- see http://github.com/MobileRobots/simulate_traversability-ros-config/issues/6 -->
        <maxVel>0.0</maxVel>
        <minDepth>0.001</minDepth>
        <material value="Gazebo/Black"/>
    </gazebo>
    <gazebo reference="p3at_front_${side}_wheel">
        <sensor name="cf_${side}" type='contact'>
          <contact>
            <collision>p3at_front_${side}_wheel_collision</collision>
          </contact>
        </sensor>
        <kp>1000000.0</kp>
        <!-- kd=1e4: ver comentário no bloco da roda traseira. -->
        <kd>10000.0</kd>
        <mu1>0.9</mu1>
        <!-- was 10 -->
        <mu2>0.9</mu2>
        <!-- how to get these into <surface><friction><ode>... ?
          slip1 0.5 /slip1
           slip2 0 /slip2
        -->
        <!-- fdir1 DECLARADO (2026-09-02). Estava comentado, e sem ele o ODE
             escolhe a direção da pirâmide de atrito a cada contato entre o
             cilindro da roda e o plano; o resíduo dessas escolhas é
             retificado num avanço constante — 2,6 mm/s com o robô parado
             e cmd_vel em zero, medido em 01 e 02/09 (atrito de junta e
             taxa do plugin não mudaram nada). A direção é expressa no
             frame da COLISÃO; o cilindro é girado -90° em X, então a
             lateral (eixo do rolamento) podia ser "0 1 0" ou "0 0 1" —
             decidido por MEDIÇÃO (robô parado, 20 s de assentamento,
             janelas de 10 s, deslocamento pela verdade do Gazebo):

               sem fdir1        2,58 mm/s  (25,8 mm em 10 s)
               fdir1 0 0 1      2,57 / 2,58 mm/s — zero efeito
               fdir1 0 1 0      0,98 -> 0,60 -> 0,05 -> 0,01 mm/s
                                (cauda do pouso do spawn decaindo; em
                                 regime, 0,1-0,5 mm em 10 s)

             As rodas continuam girando ~0,04 rad/s no lugar (o motor de
             velocidade do plugin não segura zero exatamente), mas o
             contato deixou de transformar isso em avanço do corpo. A
             odometria da missão vem do gazebo_sensor_sim (verdade), não
             do plugin, então o giro residual não contamina nada. A
             vibração vertical do contato é nula (1 µm pico-a-pico) — a
             hipótese de "vibração retificada" não explica o resíduo. -->
        <fdir1>0 1 0</fdir1>
        <!-- see http://github.com/MobileRobots/simulate_traversability-ros-config/issues/6 -->
        <maxVel>0.0</maxVel>
        <minDepth>0.001</minDepth>
        <material value="Gazebo/Black"/>
    </gazebo>
  </xacro:macro>


  <xacro:macro name="custom_laser" params="name color x y z roll pitch yaw samples resolution min_angle max_angle min_range max_range range_resolution">
    <joint name="laser_${name}_joint" type="fixed">
      <axis xyz = "1 0 0"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
      <parent link="top_plate"/>
      <child link="laser_${name}_link"/>
    </joint>

    <link name="laser_${name}_link">
        <!-- HOKUYO UST-05LX MODELADO (2026-09-02, pedido do Marco: "o hokuyo
             precisa ser renderizado/modelado, e mudado de cor para que
             possamos enxergar na simulação"). Era um cubo de 25 mm preto,
             invisível sobre o chassi. A malha é a hokuyo.dae do gazebo_plugins
             (forma da família URG/UST, mesmo envelope de 50 x 50 x 70 mm do
             UST-05LX), convertida para STL em pé, base em z = 0, e a janela
             de varredura a 34 mm da base (o lado de cima foi conferido pelo Marco
             contra o sensor real: a heurística pela faixa branca errou) — ver
             meshes/hokuyo/README.md.

             A ORIGEM DESTE LINK É O PLANO DE VARREDURA (é onde o sensor ray
             emite), então a malha desce 36 mm para a base assentar na placa.
             STL e não DAE de propósito: com materiais embutidos o Gazebo
             ignora o <material> do link, e a cor é o pedido. -->
        <collision>
          <origin xyz="0 0 -0.001" rpy="0 0 0"/>
          <geometry>
            <box size="0.050 0.050 0.070"/>
          </geometry>
        </collision>

        <visual>
          <origin xyz="0 0 -0.034" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://b166er_robot/meshes/hokuyo/hokuyo_ust05lx.stl"/>
          </geometry>
          <!-- RViz lê este <material>; o Gazebo lê o <gazebo reference> abaixo. -->
          <material name="hokuyo_laranja">
            <color rgba="1.0 0.5 0.0 1"/>
          </material>
        </visual>

        <inertial>
          <mass value="1e-5" />
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </link>


    <gazebo reference="laser_${name}_link">
        <material value="Gazebo/${color}"/>
        <sensor type="ray" name="laser_${name}">
          <pose>0 0 0 0 0 0</pose>
          <!-- visualize=true desenha os 1081 raios como disco branco no Gazebo,
               confundindo a inspeção visual do robô. Desabilitado. -->
          <visualize>false</visualize>
          <update_rate>40</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>${samples}</samples> <!-- UST-05LX: 1081 (0,25°) -->
                <resolution>${resolution}</resolution> <!-- 1 -->
                <min_angle>${min_angle}</min_angle> <!-- minus 1.570796 -->
                <max_angle>${max_angle}</max_angle> <!-- 1.570796 -->
              </horizontal>
            </scan>
            <range>
              <min>${min_range}</min> <!-- UST-05LX: 0.06 -->
              <max>${max_range}</max> <!-- UST-05LX: 5.0 -->
              <resolution>${range_resolution}</resolution> <!-- 0.01 -->
            </range>
            <noise>
              <type>gaussian</type>
              <!-- Noise parameters based on published spec for Hokuyo laser
                   achieving "+-30mm" accuracy at range < 10m.  A mean of 0.0m and
                   stddev of 0.01m will put 99.7% of samples within 0.03m of the true
                   reading. -->
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
          <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_laser.so">
            <topicName>/${robot_name}/laser_${name}/scan</topicName>
            <frameName>laser_${name}_link</frameName>
          </plugin>
        </sensor>
      </gazebo>
  </xacro:macro>


  <xacro:macro name="p3at_gazebo_ext">
    <gazebo>
      <!-- libgazebo_ros_skid_steer_drive_pioneer3at.so não existe em nenhuma instalação
           conhecida e o Gazebo falhava silenciosamente ao carregar o plugin, deixando as
           rodas completamente livres (sem controle de velocidade).
           Corrigido para o plugin padrão do ROS Noetic. commandTopic com path absoluto
           (/cmd_vel) ignora o robotNamespace e se conecta diretamente ao tópico
           publicado pelo fuzzy_wb_controller. -->
      <plugin name="skid_steer_drive_controller" filename="libgazebo_ros_skid_steer_drive.so">
        <updateRate>100.0</updateRate>
        <robotNamespace>${robot_name}</robotNamespace>
        <leftFrontJoint>p3at_front_left_wheel_joint</leftFrontJoint>
        <rightFrontJoint>p3at_front_right_wheel_joint</rightFrontJoint>
        <leftRearJoint>p3at_back_left_wheel_joint</leftRearJoint>
        <rightRearJoint>p3at_back_right_wheel_joint</rightRearJoint>
        <wheelSeparation>0.27</wheelSeparation>
        <wheelDiameter>0.17</wheelDiameter>
        <robotBaseFrame>base_link</robotBaseFrame>
        <torque>20</torque>
        <commandTopic>/cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <broadcastTF>false</broadcastTF>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="p3at_gazebo_contacts">
    <gazebo>
      <plugin name="gazeboRosPioneer3ATContacts" filename="libgazeboRosPioneer3ATContacts.so">
        <robotNamespace>${robot_name}</robotNamespace>
        <jointName>p3at_front_left_wheel_joint, p3at_front_right_wheel_joint, p3at_back_left_wheel_joint, p3at_back_right_wheel_joint</jointName>
        <linkName>p3at_front_left_wheel, p3at_front_right_wheel, p3at_back_left_wheel, p3at_back_right_wheel, base_link</linkName>
        <updateRate>100.0</updateRate>
        <alwaysOn>true</alwaysOn>
        <useROSTime>false</useROSTime>
        <publishPoseAndTwist>true</publishPoseAndTwist>
      </plugin>
    </gazebo>
  </xacro:macro>


  <!-- skid steer controller -->
  <xacro:p3at_drive_side side="left" reflect="1"/>
  <xacro:p3at_drive_side side="right" reflect="-1"/>
  <xacro:p3at_gazebo_ext/>

</robot>
