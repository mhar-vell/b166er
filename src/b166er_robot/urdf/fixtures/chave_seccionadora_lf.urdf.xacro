<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Chave seccionadora da BANCADA DE TESTES do Marco, modelada a
       partir da FOTO da bancada real (docs/img/
       chave_bancada_teste_sem_isolador.jpg no pacote whole_body_control),
       não do desenho técnico do datasheet STI — o desenho inclui o
       isolador tipo bucha, que a bancada não tem.

       Geometria, depois das correções do Marco em 2026-08-13:

       · PIVÔ EMBAIXO, OLHAL EM CIMA. A primeira versão tinha o
         contrário e o robô mirava a extremidade errada.

       · LÂMINA NO PLANO Y-Z (chave "rotacionada 90° no eixo Z"): abre
         inclinando PARA FORA da parede, na direção de onde o robô se
         aproxima. A barra do mecanismo corre paralela à face, como na
         foto.

       · FECHADA = LÂMINA VERTICAL. A versão anterior desenhava a
         lâmina já inclinada 20°, que é a posição ABERTA ("a inclinação
         que está é a posição da chave aberta" — Marco). Fechada, a
         lâmina encosta no contato fixo de cima; abrir é girá-la 30°
         para fora (curso confirmado pelo Marco).

       · OLHAL É UM ANEL, não uma barra. É por dentro dele que o gancho
         da ferramenta passa. URDF não tem primitiva de toroide, então
         o anel é aproximado por segmentos cilíndricos em círculo, no
         plano X-Z — furo voltado para o robô, para o gancho entrar de
         frente e puxar.

       Continua sendo aproximação por primitivas, não réplica de CAD. -->

  <xacro:macro name="chave_seccionadora_lf" params="parent prefix:=chave_ xyz:='0 0 0' rpy:='0 0 0'">

    <xacro:property name="olhal_height" value="0.810"/>      <!-- altura do olhal (spec do Marco) -->
    <xacro:property name="blade_length" value="0.200"/>      <!-- pivô → olhal -->
    <!-- Afastamento do mecanismo em relação à placa. Subiu de 0,03 m
         para 0,08 m em 2026-08-13, por dois motivos que convergem:
         · FÍSICO: a foto da bancada mostra o mecanismo bem destacado da
           placa (a barra e a articulação se projetam vários cm), não
           colado como 3 cm sugeriam.
         · FUNCIONAL: com 3 cm o olhal ficava a 30 mm da face, enquanto
           o bracket ocupa até 28 mm — o gancho (esfera de colisão de
           20 mm) não tinha por onde entrar. O J4 travava contra o
           bracket e a ponta parava 5 cm aquém do alvo, sintoma que
           levou horas a isolar porque parecia droop ou IK ruim. -->
    <xacro:property name="wall_standoff" value="0.08"/>

    <!-- Placa de fundo (a branca da foto, parafusada na parede). -->
    <xacro:property name="plate_w" value="0.16"/>
    <xacro:property name="plate_h" value="0.62"/>
    <xacro:property name="plate_t" value="0.012"/>

    <!-- Anel do olhal -->
    <xacro:property name="ring_r" value="0.028"/>      <!-- raio do furo -->
    <xacro:property name="ring_t" value="0.006"/>      <!-- espessura do arame -->
    <xacro:property name="ring_seg" value="10"/>       <!-- segmentos do círculo -->

    <!-- Fechada: lâmina vertical, olhal direto acima do pivô. -->
    <xacro:property name="pivot_z" value="${olhal_height - blade_length}"/>

    <!-- ═══ Placa de fundo ═══ -->
    <link name="${prefix}plate">
      <visual>
        <origin xyz="0 ${plate_t/2} ${plate_h/2 - 0.10}"/>
        <geometry><box size="${plate_w} ${plate_t} ${plate_h}"/></geometry>
        <material name="switch_plate"><color rgba="0.93 0.92 0.88 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 ${plate_t/2} ${plate_h/2 - 0.10}"/>
        <geometry><box size="${plate_w} ${plate_t} ${plate_h}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <joint name="${prefix}plate_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}plate"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- ═══ Bracket inferior = PIVÔ ═══ -->
    <link name="${prefix}bracket">
      <visual>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.14"/></geometry>
        <material name="galvanized"><color rgba="0.55 0.55 0.58 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.14"/></geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}bracket_joint" type="fixed">
      <parent link="${prefix}plate"/>
      <child link="${prefix}bracket"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ═══ Bracket superior = contato fixo (a lâmina fechada encosta
         nele) ═══ -->
    <link name="${prefix}fixed_terminal">
      <visual>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.19"/></geometry>
        <material name="galvanized"/>
      </visual>
      <collision>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.19"/></geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}fixed_terminal_joint" type="fixed">
      <parent link="${prefix}plate"/>
      <child link="${prefix}fixed_terminal"/>
      <origin xyz="0 0 ${blade_length + 0.14}" rpy="0 0 0"/>
    </joint>

    <!-- ═══ Lâmina móvel — VERTICAL (posição fechada) ═══ -->
    <link name="${prefix}blade">
      <visual>
        <origin xyz="0 0 ${blade_length/2}"/>
        <geometry><box size="0.016 0.022 ${blade_length}"/></geometry>
        <material name="switch_dark"><color rgba="0.22 0.14 0.10 1"/></material>
      </visual>
      <!-- Lâmina SEM colisão, pelo mesmo motivo do olhal: o anel fica
           no TOPO dela, então o gancho que mira o centro do anel
           encosta na lâmina e trava. Medido: J4 cravado enquanto a IK
           pedia de -41,9° a -2,9° (defasagem crescendo até 30,7°),
           ponta congelada 5,7 cm aquém.

           Colisão só faz sentido nas partes ESTRUTURAIS (placa,
           brackets), que é onde o robô realmente não pode entrar. A
           lâmina é o alvo da manipulação e sua abertura é acoplada
           cinematicamente (set_blade_angle), não pelo contato. -->
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/>
      </inertial>
    </link>

    <!-- JUNTA REAL DE ABERTURA (2026-08-13): era 'fixed', e por isso a
         chave não abria de jeito nenhum quando o robô puxava — o Marco
         notou. Agora é revoluta em torno de X, o que faz a lâmina
         girar no plano Y-Z, para fora da parede. Curso 0 → 30°
         (fechada → aberta), o mesmo confirmado pelo Marco. -->
    <joint name="${prefix}blade_joint" type="revolute">
      <parent link="${prefix}bracket"/>
      <child link="${prefix}blade"/>
      <origin xyz="0 ${wall_standoff} 0" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="0.60" effort="40" velocity="1.0"/>
      <!-- Atrito alto: chave de manobra é dura, não cai sozinha pela
           gravidade nem oscila. Também deixa a posição estável quando
           o ângulo é imposto por set_model_configuration. -->
      <dynamics damping="5.0" friction="8.0"/>
    </joint>

    <!-- ═══ OLHAL: anel no topo da lâmina, a 810 mm do chão. Este é o
         frame que o controlador mira, e é por dentro dele que o gancho
         da ferramenta passa.

         O anel fica no plano X-Z (normal ao longo de Y), ou seja, com o
         FURO VOLTADO PARA O ROBÔ — o gancho entra de frente e puxa.
         Aproximado por ${ring_seg} cilindros curtos em círculo, já que
         o URDF não tem toroide. A colisão é uma esfera única: o
         contato fino do gancho no anel não é simulado nesta fase (a
         tarefa é validada por posição do EE, não por contato). ═══ -->
    <link name="${prefix}olhal_link">
      <xacro:macro name="ring_seg_vis" params="i">
        <xacro:property name="a" value="${2*pi*i/ring_seg}"/>
        <visual>
          <origin xyz="${ring_r*cos(a)} 0 ${ring_r*sin(a)}"
                  rpy="${pi/2} ${-a} 0"/>
          <geometry>
            <cylinder radius="${ring_t/2}" length="${2*pi*ring_r/ring_seg*1.15}"/>
          </geometry>
          <material name="galvanized"/>
        </visual>
      </xacro:macro>
      <xacro:ring_seg_vis i="0"/>
      <xacro:ring_seg_vis i="1"/>
      <xacro:ring_seg_vis i="2"/>
      <xacro:ring_seg_vis i="3"/>
      <xacro:ring_seg_vis i="4"/>
      <xacro:ring_seg_vis i="5"/>
      <xacro:ring_seg_vis i="6"/>
      <xacro:ring_seg_vis i="7"/>
      <xacro:ring_seg_vis i="8"/>
      <xacro:ring_seg_vis i="9"/>
      <!-- SEM COLISÃO no olhal (2026-08-13). Havia aqui uma esfera
           sólida de raio ${ring_r} "aproximando" o anel — mas para a
           física isso é uma BOLA MACIÇA, não um anel vazado: o gancho
           batia nela em vez de atravessar. Sintoma medido: durante o
           engate o J4 ficava cravado em ~-84° por mais que a IK
           pedisse (-77,8° → -55,5°), a ponta congelada a 3 cm do alvo,
           e a iteração só aumentava a defasagem (-5,1° → -29,8°).
           Nada disso era droop nem IK ruim — era o gancho empurrando
           uma esfera invisível.

           Modelar o anel como toroide de colisão (vários cilindros)
           seria caro e inútil aqui: a abertura da chave é acoplada
           CINEMATICAMENTE (ver set_blade_angle em chave_mission.py),
           não pelo contato gancho-anel. Sem colisão, o gancho alcança
           o centro do anel, que é o que o controlador mira. -->
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="${prefix}olhal_joint" type="fixed">
      <parent link="${prefix}blade"/>
      <child link="${prefix}olhal_link"/>
      <origin xyz="0 0 ${blade_length}" rpy="0 0 0"/>
    </joint>

    <!-- ═══ Materiais Gazebo explícitos (o <material><color> do URDF
         some na fusão de corpo rígido da cadeia de juntas fixas) ═══ -->
    <gazebo reference="${prefix}plate">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}bracket">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${prefix}fixed_terminal">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${prefix}blade">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="${prefix}olhal_link">
      <material>Gazebo/Orange</material>
    </gazebo>

  </xacro:macro>

</robot>
