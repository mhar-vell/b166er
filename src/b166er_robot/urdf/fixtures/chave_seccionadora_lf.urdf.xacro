<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Chave seccionadora da BANCADA DE TESTES do Marco — remodelada em
       2026-08-13 a partir da FOTO da bancada real (docs/img/
       chave_bancada_teste_sem_isolador.jpg no pacote whole_body_control),
       não mais do desenho técnico do datasheet STI.

       Por que mudou: o desenho do datasheet inclui o isolador tipo bucha,
       que a bancada não tem, e a silhueta resultante não lembrava a
       chave real ("a renderização da chave não está parecido com o
       real" — Marco). A foto mostra outra coisa: uma placa branca
       parafusada na parede, um bracket metálico chato no topo, um
       mecanismo escuro em forma de wishbone descendo, a barra
       horizontal do olhal atravessando, e um segundo bracket metálico
       na base.

       INVERSÃO DA MECÂNICA (correção do Marco, 2026-08-13): o PIVÔ fica
       EMBAIXO e o OLHAL EM CIMA. A versão anterior tinha isso ao
       contrário (lâmina pendurada de um pivô superior), o que colocava
       o alvo de manipulação na extremidade errada da chave — o robô
       mirava a ponta de baixo.

       O QUE NÃO MUDOU, de propósito: a posição do olhal no mundo
       (810 mm do chão, mesmo offset lateral). É a esse ponto que o
       pipeline de percepção e chave_task.py estão calibrados; inverter
       a mecânica abaixo dele não mexe no alvo. Ver
       OLHAL_OFFSET_FROM_WALL_LINK em chave_task.py.

       Continua sendo aproximação por primitivas, não réplica de CAD. -->

  <xacro:macro name="chave_seccionadora_lf" params="parent prefix:=chave_ xyz:='0 0 0' rpy:='0 0 0'">

    <!-- ═══ Parâmetros ═══ -->
    <xacro:property name="olhal_height" value="0.810"/>      <!-- altura do olhal (spec do Marco) -->
    <xacro:property name="blade_length" value="0.200"/>      <!-- pivô → olhal -->
    <xacro:property name="blade_angle" value="0.349"/>       <!-- 20° da vertical, posição fechada -->
    <xacro:property name="wall_standoff" value="0.03"/>      <!-- afastamento da face da parede -->

    <!-- Placa branca de fundo (a que aparece na foto, parafusada na
         parede e servindo de base para os dois brackets). -->
    <xacro:property name="plate_w" value="0.16"/>
    <xacro:property name="plate_h" value="0.62"/>
    <xacro:property name="plate_t" value="0.012"/>

    <!-- Deslocamento horizontal do olhal em relação ao pivô, pela
         inclinação de 20° da lâmina fechada. Com o pivô EMBAIXO, o
         olhal sobe: +cos em Z, e o mesmo afastamento lateral de antes
         (sinal mantido para o olhal não mudar de lugar no mundo). -->
    <xacro:property name="pivot_dz" value="${blade_length*cos(blade_angle)}"/>
    <xacro:property name="pivot_dx" value="${blade_length*sin(blade_angle)}"/>

    <!-- Origem do macro (bracket de montagem) = PIVÔ, embaixo. -->
    <xacro:property name="pivot_z" value="${olhal_height - pivot_dz}"/>

    <!-- ═══ Placa branca de fundo ═══ -->
    <link name="${prefix}plate">
      <visual>
        <origin xyz="0 ${plate_t/2} ${plate_h/2 - 0.10}"/>
        <geometry><box size="${plate_w} ${plate_t} ${plate_h}"/></geometry>
        <material name="switch_plate"><color rgba="0.93 0.92 0.88 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 ${plate_t/2} ${plate_h/2 - 0.10}"/>
        <geometry><box size="${plate_w} ${plate_t} ${plate_h}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <joint name="${prefix}plate_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}plate"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- ═══ Bracket inferior = PIVÔ da lâmina (chapa metálica chata,
         parafusada na placa — a de baixo na foto) ═══ -->
    <link name="${prefix}bracket">
      <visual>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.14"/></geometry>
        <material name="galvanized"><color rgba="0.55 0.55 0.58 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.14"/></geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}bracket_joint" type="fixed">
      <parent link="${prefix}plate"/>
      <child link="${prefix}bracket"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ═══ Bracket superior = contato fixo (a chapa de cima na foto,
         com o furo no topo) ═══ -->
    <link name="${prefix}fixed_terminal">
      <visual>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.19"/></geometry>
        <material name="galvanized"/>
      </visual>
      <collision>
        <origin xyz="0 ${wall_standoff*0.6} 0"/>
        <geometry><box size="0.045 0.020 0.19"/></geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}fixed_terminal_joint" type="fixed">
      <parent link="${prefix}plate"/>
      <child link="${prefix}fixed_terminal"/>
      <origin xyz="0 0 ${pivot_dz + 0.16}" rpy="0 0 0"/>
    </joint>

    <!-- ═══ Lâmina móvel: SOBE do pivô até o olhal, inclinada ~20°
         (o mecanismo escuro da foto) ═══ -->
    <link name="${prefix}blade">
      <visual>
        <origin xyz="${-pivot_dx/2} 0 ${blade_length/2}" rpy="0 ${-blade_angle} 0"/>
        <geometry><box size="0.022 0.016 ${blade_length}"/></geometry>
        <material name="switch_dark"><color rgba="0.22 0.14 0.10 1"/></material>
      </visual>
      <collision>
        <origin xyz="${-pivot_dx/2} 0 ${blade_length/2}" rpy="0 ${-blade_angle} 0"/>
        <geometry><box size="0.022 0.016 ${blade_length}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/>
      </inertial>
    </link>

    <joint name="${prefix}blade_joint" type="fixed">
      <parent link="${prefix}bracket"/>
      <child link="${prefix}blade"/>
      <origin xyz="0 ${wall_standoff} 0" rpy="0 0 0"/>
    </joint>

    <!-- ═══ Olhal: a barra horizontal que atravessa o mecanismo na foto
         — é onde a ferramenta engata. Este é o frame que o controlador
         mira; fica no TOPO da lâmina, a 810 mm do chão. ═══ -->
    <link name="${prefix}olhal_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.011" length="0.13"/></geometry>
        <material name="galvanized"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.022"/></geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="${prefix}olhal_joint" type="fixed">
      <parent link="${prefix}blade"/>
      <child link="${prefix}olhal_link"/>
      <origin xyz="${-pivot_dx} 0 ${pivot_dz}" rpy="0 0 0"/>
    </joint>

    <!-- ═══ Materiais Gazebo explícitos — o <material><color> do URDF
         some na fusão de corpo rígido da cadeia de juntas fixas
         (comportamento confirmado ao vivo, ver histórico). ═══ -->
    <gazebo reference="${prefix}plate">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}bracket">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${prefix}fixed_terminal">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${prefix}blade">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="${prefix}olhal_link">
      <material>Gazebo/Grey</material>
    </gazebo>

  </xacro:macro>

</robot>
