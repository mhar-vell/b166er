<?xml version="1.0"?>
<robot name="chave_seccionadora_fixture" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Fixture combinada: parede + chave seccionadora LF + suporte da tag
       AprilTag, spawnada como modelo Gazebo separado do b166er (não faz
       parte do robot_description do robô — é o alvo da tarefa de
       manipulação, a bancada de testes contra a qual o robô deve
       navegar e depois manipular).

       Uso:
         roslaunch b166er_robot spawn_chave_fixture.launch \
           x:=3.0 y:=0.0 yaw:=3.14159

       Layout: parede fina (1,0 x 0,10 x 1,40 m), base no chão (Z=0).
       A chave e a tag ficam fixadas na face frontal da parede (Y=0 no
       frame local da parede), lado a lado (chave em X=-0,20, tag em
       X=+0,20). O yaw de spawn (padrão π) gira a fixture inteira para
       que essa face frontal aponte de volta para onde o robô nasce no
       mundo — ver spawn_chave_fixture.launch para o cálculo. -->

  <xacro:include filename="$(find b166er_robot)/urdf/fixtures/chave_seccionadora_lf.urdf.xacro"/>
  <xacro:include filename="$(find b166er_robot)/urdf/fixtures/apriltag_mount.urdf.xacro"/>

  <!-- ═══ Parâmetros da parede ═══ -->
  <xacro:property name="wall_width" value="1.6"/>
  <xacro:property name="wall_thickness" value="0.10"/>
  <xacro:property name="wall_height" value="1.40"/>
  <xacro:property name="chave_x_offset" value="-0.20"/>

  <!-- ═══ POSIÇÃO DA TAG — MEDIDA NA BANCADA (2026-08-26) ═══
       olhal-dimension.png: o centro da tag fica a 17 cm do olhal, na
       horizontal, e NA MESMA ALTURA dele. Toda a geometria anterior era
       arbitrada: 30 cm de separação e 22 cm acima do olhal.

       Isso muda o erro de percepção de forma direta. A missão estima a
       pose da PAREDE pela tag e depois aplica offsets em YAML para
       chegar ao olhal; quanto maior esse braço, mais o erro ANGULAR da
       detecção vira erro de POSIÇÃO no alvo. Passar de 37 cm de
       distância tag→olhal para 17 cm corta esse braço por 2,2.

       CONSEQUÊNCIA QUE PRECISA DE DECISÃO: com 17 cm de separação a tag
       de 220 mm não cabe mais ao lado da chave. Contas de meia-placa:
         meia-placa da chave ......... 8,0 cm
         meia-placa da tag 220 mm .... 13,75 cm  -> precisa de 21,75 cm
         meia-placa da tag 132 mm .... 8,25 cm   -> precisa de 16,25 cm
       Só a de 132 mm cabe nos 17 cm medidos — e é justamente a que o
       Marco tem impressa. Por isso o padrão volta para 132 mm.

       O preço é conhecido e já estava documentado: com 132 mm a
       detecção confiável termina em ~1,8 m (T265 real, medido em
       2026-08-26), e o SEARCH da missão acontece a 2,8 m. Ou a busca
       desce para menos de 1,8 m, ou a bancada precisa afastar a tag do
       olhal para caber a de 220 mm. As duas saídas são medições, não
       chutes — mas são decisão do Marco. -->
  <xacro:property name="tag_olhal_dx" value="0.17"/>
  <xacro:property name="tag_x_offset" value="${chave_x_offset - tag_olhal_dx}"/>
  <xacro:property name="tag_black_size" value="0.132"/>

  <!-- Altura de montagem do macro da chave = altura do PIVÔ (embaixo).
       Precisa bater com o cálculo interno de chave_seccionadora_lf
       (pivot_z), que o xacro não expõe para fora do macro:
       olhal_height=0.805 (MEDIDO), blade_length=0.200, lâmina VERTICAL
       quando fechada. Mecânica invertida em 2026-08-13 (pivô embaixo,
       olhal em cima) e depois rotacionada 90° no eixo Z (lâmina abre
       para fora da parede). -->
  <xacro:property name="olhal_z" value="0.805"/>
  <xacro:property name="chave_pivot_z"
    value="${olhal_z - 0.200}"/>  <!-- 0,605 m — lâmina VERTICAL na posição fechada -->

  <!-- Mesma altura do olhal (medido). Era 1.030. -->
  <xacro:property name="tag_mount_z" value="${olhal_z}"/>

  <!-- ═══ Parede: base no chão, face frontal (mounting) em Y=0 do frame
       local, corpo se estendendo para -Y (atrás) ═══ -->
  <link name="wall_link">
    <visual>
      <origin xyz="0 ${-wall_thickness/2} ${wall_height/2}"/>
      <geometry><box size="${wall_width} ${wall_thickness} ${wall_height}"/></geometry>
      <material name="wall_concrete"><color rgba="0.72 0.70 0.65 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 ${-wall_thickness/2} ${wall_height/2}"/>
      <geometry><box size="${wall_width} ${wall_thickness} ${wall_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <!-- Material Gazebo explícito — ver nota em chave_seccionadora_lf.urdf.xacro
       sobre por que o <material><color> puro do URDF não é confiável
       aqui (wall_link é o corpo raiz que acaba absorvendo todos os
       links filhos ligados por junta fixa). -->
  <gazebo reference="wall_link">
    <material>Gazebo/Grey</material>
    <!-- O laço do gatilho (chave_laco) é fundido aqui pelas juntas
         fixas, e a aba da lingueta precisa COLIDIR com ele — par de
         links do mesmo modelo, que o Gazebo só testa com selfCollide.
         Links ligados por junta (a lâmina) continuam excluídos. Ver a
         nota da lingueta em chave_seccionadora_lf.urdf.xacro. -->
    <selfCollide>true</selfCollide>
  </gazebo>

  <xacro:chave_seccionadora_lf parent="wall_link" prefix="chave_"
    xyz="${chave_x_offset} 0 ${chave_pivot_z}" rpy="0 0 0"/>

  <xacro:apriltag_mount parent="wall_link" prefix="tag_"
    xyz="${tag_x_offset} 0 ${tag_mount_z}" rpy="0 0 0"
    black_size="${tag_black_size}"/>

  <!-- A fixture NÃO pode mais ser <static>: modelo estático no Gazebo
       não simula juntas, e a lâmina precisa girar para a chave abrir
       (2026-08-13 — antes disso a chave era um bloco rígido e não
       abria quando o robô puxava).

       Em vez de 'static', a parede é ancorada ao mundo por uma junta
       fixa ao link especial 'world'. Efeito prático igual — a parede
       não sai do lugar por contato — mas a lâmina continua livre para
       girar na sua junta revoluta. -->
  <link name="world"/>
  <joint name="world_anchor" type="fixed">
    <parent link="world"/>
    <child link="wall_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
