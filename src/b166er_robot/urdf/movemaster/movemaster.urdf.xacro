<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Mitsubishi RV-M2, xacro-izado a partir de src/movemaster_urdf.xml.
       Mantém os mesmos nomes de junta (J1..J5, JGrip1/2) usados pelo
       movemaster_state_publisher real, para que o mesmo /joint_states
       sirva tanto a simulação quanto o hardware. -->
  <xacro:macro name="movemaster_rv_m2" params="parent xyz:='0 0 0' rpy:='0 0 0'">

    <joint name="movemaster_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="Base"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="Base">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/Base.stl" scale="1 1 1.7"/>
        </geometry>
        <material name="BaseColor">
          <color rgba="0.50 0.53 0.47 1"/>
        </material>
      </visual>
      <!-- Massa/inércia: distribuição proporcional ao placeholder original,
           escalada para somar ~28kgf (peso total real do RV-M2, manual de
           instruções Mitsubishi BFP-A5296, tabela 1.3.1). Distribuição por
           elo ainda é estimada — substituir quando medido no laboratório. -->
      <inertial>
        <mass value="8.4"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.084" ixy="0" ixz="0" iyy="0.084" iyz="0" izz="0.084"/>
      </inertial>
    </link>

    <joint name="J1" type="revolute">
      <axis xyz="0 0 1"/>
      <origin xyz="0 0 0.400" rpy="0 0 0"/>
      <parent link="Base"/>
      <child link="L1"/>
      <!-- Cintura (waist): 300° de curso total no manual, assumido ±150° -->
      <limit upper="2.61799" lower="-2.61799" effort="30" velocity="3.14" />
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <link name="L1">
      <visual>
        <origin xyz="0 0 -0.160" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/L1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="L1Color">
          <color rgba="0.15 0.2 0.8 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="6.3"/>
        <origin xyz="0 0 -0.16" rpy="0 0 0"/>
        <inertia ixx="0.063" ixy="0" ixz="0" iyy="0.063" iyz="0" izz="0.063"/>
      </inertial>
    </link>

    <!-- Sparton AHRS-8 — face traseira de L1 (bunda do manipulador, eixo 2),
         confirmado por foto do robô real. Offset: 5 cm atrás do eixo J1,
         10 cm abaixo; orientado 180° em yaw (face para trás do braço). -->
    <joint name="imu_mount_joint" type="fixed">
      <origin xyz="-0.05 0 0.02" rpy="0 0 ${PI}"/>
      <parent link="L1"/>
      <child link="ahrs8_link"/>
    </joint>

    <!-- Sensor IMU no Gazebo (2026-08-13). Estava faltando: a AHRS-8
         existia no URDF como geometria, mas sem sensor — nada publicava
         /imu/data e o robô tombou várias vezes sem nenhum aviso, tendo
         um sensor de atitude a bordo (o Marco notou).

         CONVENIENTE: a AHRS-8 é filha de L1, e L1 gira em relação à
         base APENAS em torno de Z (J1 tem axis="0 0 1" e origem sem
         rpy; a montagem da IMU também só tem yaw). Logo o ROLL e o
         PITCH medidos pela IMU são IDÊNTICOS aos do chassi — para
         detecção de tombamento não é preciso compensar a configuração
         do braço. Só o yaw difere (por q1 + π). -->
    <gazebo reference="ahrs8_link">
      <gravity>true</gravity>
      <sensor name="ahrs8_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <plugin name="ahrs8_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <topicName>/imu/data</topicName>
          <bodyName>ahrs8_link</bodyName>
          <frameName>ahrs8_link</frameName>
          <updateRateHZ>50.0</updateRateHZ>
          <gaussianNoise>0.002</gaussianNoise>
        </plugin>
      </sensor>
    </gazebo>

    <link name="ahrs8_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
        <material name="imu_color">
          <color rgba="1.0 1.0 0.0 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="1e-5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="J2" type="revolute">
      <axis xyz="0 0 1"/>
      <origin xyz="0.120 0 0" rpy="1.57 0 0"/>
      <parent link="L1"/>
      <child link="L2"/>
      <!-- Ombro (shoulder): 130° de curso total no manual, assumido ±65° -->
      <limit upper="1.13446" lower="-1.13446" effort="80" velocity="2.09" />
      <dynamics damping="1.0" friction="0.0"/>
    </joint>

    <link name="L2">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57 0 0" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/L2.stl"/>
        </geometry>
        <material name="L2Color">
          <color rgba="0.86 0.86 0.86 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="5.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.050" ixy="0" ixz="0" iyy="0.050" iyz="0" izz="0.050"/>
      </inertial>
    </link>

    <joint name="J3" type="revolute">
      <axis xyz="0 0 1"/>
      <origin xyz="0.250 0 0" rpy="0 0 0"/>
      <parent link="L2"/>
      <child link="L3"/>
      <!-- Cotovelo (elbow): 120° de curso total no manual, assumido ±60° -->
      <limit upper="1.04720" lower="-1.04720" effort="50" velocity="2.09" />
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <link name="L3">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57 0 0" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/L3.stl"/>
        </geometry>
        <material name="L3Color">
          <color rgba="0.86 0.86 0.86 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="4.2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.042" ixy="0" ixz="0" iyy="0.042" iyz="0" izz="0.042"/>
      </inertial>
    </link>

    <joint name="J4" type="revolute">
      <axis xyz="0 0 1"/>
      <origin xyz="0.200 0 0" rpy="0 0 0"/>
      <parent link="L3"/>
      <child link="L4"/>
      <!-- Punho pitch (wrist pitch): ±110° no manual -->
      <limit upper="1.91986" lower="-1.91986" effort="20" velocity="3.14" />
      <dynamics damping="0.3" friction="0.0"/>
    </joint>

    <link name="L4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/L4.stl"/>
        </geometry>
        <material name="L4Color">
          <color rgba="0.86 0.86 0.86 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="2.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.025"/>
      </inertial>
    </link>

    <joint name="J5" type="revolute">
      <axis xyz="0 0 1"/>
      <origin xyz="0 0 0" rpy="0 -1.57 0"/>
      <parent link="L4"/>
      <child link="L5"/>
      <!-- Punho roll (wrist roll): ±180° no manual -->
      <limit upper="3.14159" lower="-3.14159" effort="10" velocity="6.28" />
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="L5">
      <visual>
        <origin xyz="0 0 -0.08" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/L5.stl"/>
        </geometry>
        <material name="L5Color">
          <color rgba="0.25 0.25 0.25 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="1.7"/>
        <origin xyz="0 0 -0.08" rpy="0 0 0"/>
        <inertia ixx="0.017" ixy="0" ixz="0" iyy="0.017" iyz="0" izz="0.017"/>
      </inertial>
    </link>

    <joint name="JCam" type="fixed">
      <origin xyz="0 0 -0.080" rpy="0 0 0"/>
      <parent link="L5"/>
      <child link="CameraSupport"/>
    </joint>

    <link name="CameraSupport">
      <visual>
        <origin xyz="0.255 -0.18 0" rpy="0 3.14 0" />
        <geometry>
          <!-- SEM AS CÂMERAS DECORATIVAS (2026-09-02, a pedido do Marco).
               A malha original, suporte_movemaster_com_cameras.stl, traz
               DUAS D435 desenhadas em cima da chapa. Nenhuma delas existe
               na bancada: o robô tem uma T265, e ela é declarada como
               link próprio logo abaixo. Câmera desenhada que não é sensor
               engana quem olha a simulação para conferir a montagem — foi
               exatamente uma delas que a gente confundiu com a T265.
               Aqui ficou só a estrutura: 1104 triângulos contra 269936,
               e os furos de fixação preservados (é por eles que a T265 se
               posiciona). Gerada por componentes conectadas; a original
               segue intocada no submódulo. -->
          <mesh filename="package://b166er_robot/meshes/movemaster/suporte_movemaster.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="CameraSupportColor">
          <color rgba="0.15 0.2 0.8 1"/>
        </material>
      </visual>
    </link>

    <!-- T265 NO BERÇO DE CIMA DO SUPORTE — posição MEDIDA na malha, não
         estimada (2026-09-02, a pedido do Marco: "a T265 deve ir para o
         suporte na posição superior").

         O suporte_movemaster_com_cameras.stl tem DUAS câmeras modeladas
         nele (o nome do arquivo não é acidente), ambas de 90x25x25 mm com
         três lentes espaçadas de 50 mm — geometria de D435, uma no berço
         de baixo (inclinada) e outra no de cima (alinhada aos eixos). A
         T265 vai no de cima.

         MAS A POSIÇÃO NÃO É O BERÇO: é onde os FUROS põem a T265. O
         Marco: "ela fixou-se na mesma posição dos furos do suporte". A
         câmera modelada no berço de cima é uma D435 (90x25x25 mm, três
         lentes espaçadas de 50 mm); a T265 da bancada tem 108x24,5x12,5
         mm — METADE da espessura. Apoiar a T265 no mesmo plano e assumir
         a face da D435 punha a origem 12,8 mm à frente do lugar.

         Medido na malha, separada em componentes conectadas e
         transformada pelo <visual> do CameraSupport (escala 1e-3,
         rpy 0 3.14 0, xyz 0.255 -0.18 0):

           furos de fixação (⌀3,5 mm = M3)  x_stl 230.92 e 281.42
                                            y_stl 266.03 (mesma linha)
           espaçamento entre furos          50,50 mm
           plano de apoio da peça           z_stl 6,50

         Os 50,50 mm entre furos são o padrão de montagem da T265 — é o
         que confirma que estes furos são dela, e não do berço da D435.

         Face das lentes = apoio + espessura = 6,50 + 12,5 = 19,00 mm.

         A ORIGEM DO t265_link É O CENTRO DE RASTREAMENTO, e a doc da
         Intel (doc/t265.md do librealsense) é explícita: "the center of
         tracking corresponds to the center location between the right and
         left monochrome imagers on the PCB" — nem o centro do corpo, nem
         um canto. É por isso que JFisheye1 desloca 32 mm logo abaixo:
         metade da baseline de 64 mm. Origem, então, no meio dos furos em
         X e Y, no plano das lentes em Z.

         ORIENTAÇÃO: rpy="-1.5708 1.5708 0" põe o eixo óptico (+X) em -Z
         do CameraSupport — exatamente para onde a ferramenta aponta. A
         montagem anterior (rpy="0 2.1 1.57") olhava 30,3° fora de -Z, e
         era a tal "rotação tortuosa" que o comentário da câmera de tarefa
         menciona logo abaixo.

         ROLAGEM: 180° em torno do EIXO ÓPTICO em relação ao que estava
         aqui até 2026-09-02. Eu tinha preservado a rolagem antiga por
         conservadorismo, e ficou errado — o Marco viu na simulação e
         corrigiu: "a conexão da camera fica do outro lado". O conector
         USB-C fica na ponta -X da malha (a face de lá tem 338 triângulos
         em 231 mm², contra 120 em 331 mm² do outro lado: mais geometria
         em menos área é o recorte do conector), e essa ponta estava
         caindo em +X do CameraSupport quando deveria cair em -X.

         O giro é em torno do eixo óptico porque é a ÚNICA rotação rígida
         que troca o conector de lado sem tirar a câmera de mira: o eixo
         óptico continua em -Z. Em troca, a câmera fica de cabeça para
         baixo em relação a antes — que é a montagem real da bancada.

         CONSEQUÊNCIA QUE NÃO É COSMÉTICA: a fisheye1 fica 32 mm em +Y do
         link, então ela atravessou 64 mm para o outro lado do suporte. A
         câmera que enxerga mudou de lugar, e com ela a geometria da
         detecção. A extrínseca interna (JFisheye1, medida na bancada em
         2026-08-26) não muda com isso: ela descreve o dispositivo por
         dentro, não como ele foi parafusado.

         ATENÇÃO: esta transformada é duplicada em kinematics.py
         (_T_L5_T265). As duas TÊM que andar juntas — foi uma cópia
         desatualizada desse tipo que pôs a parede 0,795 m fora do lugar e
         ainda assim terminou a missão em MISSION_OK. -->
    <joint name="t265_mount_joint" type="fixed">
      <origin xyz="-0.0011 0.0860 -0.0194" rpy="1.5708 1.5708 0"/>
      <parent link="CameraSupport"/>
      <child link="t265_link"/>
    </joint>

    <link name="t265_link">
      <!-- MALHA OFICIAL DA INTEL, não uma aproximação.
           A realsense.stl que estava aqui mede 148x30x28 mm e não é uma
           T265 — o Marco reparou olhando a simulação ("a modelagem da
           T265 que vc está simulando é um pouco diferente da T265 que
           tenho na bancada") e mandou a foto da peça e o repositório.
           Esta malha vem de common/res/sources/T265.obj do librealsense
           (Apache-2.0), convertida para STL binário, e mede
           108,00 x 24,49 x 12,50 mm — a T265 de verdade.

           POSE DA MALHA, e por que não é arbitrária: a origem do link é o
           CENTRO DE RASTREAMENTO, que a doc da Intel define como o ponto
           médio entre as duas fisheyes. Achei as duas na malha (as
           concavidades da face frontal) em X = -30,86 e X = +33,88 mm,
           separadas por 64,74 mm — a baseline nominal de 64 mm. O rpy
           gira os eixos da malha (X = linha das fisheyes, Y = altura,
           Z = frente) para os do link (X = eixo óptico, Y = linha das
           fisheyes, Z = altura), e o xyz leva o ponto médio delas para a
           origem.

           A CONFERÊNCIA QUE IMPORTA: com esta pose, as fisheyes caem em
           y = ±0,03237 m no t265_link. O JFisheye1 logo abaixo usa
           +0,032, medido na bancada em 2026-08-26, por outro caminho e
           em outro dia. 0,4 mm de diferença entre a malha da Intel e a
           régua da bancada — as duas descrevem a mesma peça.

           O corpo fica assimétrico em torno da origem (y de -0,0636 a
           +0,0444) e isso está certo: o centro de rastreamento não é o
           centro do corpo, as fisheyes não são simétricas nas pontas. -->
      <visual>
        <origin xyz="0 -0.00151 0.00033" rpy="1.5708 0 1.5708"/>
        <geometry>
          <mesh filename="package://b166er_robot/meshes/movemaster/t265.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="t265_color">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>

    <!-- ═══ FISHEYE 1 DA T265 — a câmera que o robô REALMENTE tem ═══
         Acrescentada em 2026-08-26 depois de o Marco reforçar que a
         bancada não tem a câmera de tarefa: ela foi invenção minha para
         destravar a percepção em simulação, e tudo que validamos com
         ela (alcance de detecção, ponto cego no standoff, taxa de
         acerto do SEARCH) não valia para o robô real.

         Aqui a simulação passa a exercitar EXATAMENTE o mesmo caminho
         do hardware: mesmos tópicos (/camera/fisheye1/*), mesmo modelo
         de lente, mesma resolução.

         wideanglecamera com lente EQUIDISTANTE: é o modelo da T265
         (Kannala-Brandt). Usar uma câmera pinhole comum aqui daria
         números otimistas — a distorção fisheye é justamente o que
         degrada o PnP longe do centro do quadro.

         848x800 e ~157° de FOV horizontal são as specs da T265. Isso dá
         5,4 px/grau contra 7,4 da câmera que inventei: mais campo,
         menos resolução angular. Consequência já calculada: a detecção
         confiável com a tag de 220 mm cai de ~3,9 m para ~2,8 m. ═══ -->
    <!-- A FISHEYE1 NÃO ESTÁ NO CENTRO DA T265 (medido em 2026-08-26).
         O driver publica a extrínseca t265_link -> fisheye1_optical como
         translação de 32 mm em Y, rotação [-90°, 0°, -90°] (a convenção
         óptica padrão).

         O modelo assumia os dois no mesmo ponto. Um deslocamento fixo na
         origem do raio de projeção produz erro de pose que cresce com a
         distância angular à tag — candidato direto ao erro proporcional
         que travou a simulação em 2026-08-26.

         Aqui o sensor é declarado num link próprio, deslocado, em vez de
         pendurado direto no t265_link. -->
    <joint name="JFisheye1" type="fixed">
      <origin xyz="0 0.032 0" rpy="0 0 0"/>
      <parent link="t265_link"/>
      <child link="t265_fisheye1_frame"/>
    </joint>

    <link name="t265_fisheye1_frame">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>

    <gazebo reference="t265_fisheye1_frame">
      <sensor type="wideanglecamera" name="t265_fisheye1">
        <update_rate>15.0</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <camera>
          <!-- 170,3° — MEDIDO na T265 real em 2026-08-26, não a
               especificação. Invertendo fx=285,32 do camera_info do
               driver para 848 px com r=f·θ: hfov = 2·(w/2)/fx = 2,9724
               rad. A especificação de 163° diagonal me levara a assumir
               157° horizontais; a lente é mais aberta que isso, o que
               reduz a resolução angular de 5,41 para 4,98 px/grau. -->
          <horizontal_fov>2.9724</horizontal_fov>
          <image><width>848</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50.0</far></clip>
          <lens>
            <type>equidistant</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.5707</cutoff_angle>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name="t265_fisheye1_controller" filename="libgazebo_ros_camera.so">
          <cameraName>camera/fisheye1</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <!-- O camera_info do Gazebo vai para um tópico MORTO: ele
               descreve a lente como pinhole e com fx errado. Quem publica
               o /camera/fisheye1/camera_info é o fisheye_info_fixer. -->
          <cameraInfoTopicName>camera_info_gazebo</cameraInfoTopicName>
          <frameName>t265_fisheye1_frame</frameName>
          <hackBaseline>0.0</hackBaseline>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ═══ Câmera de tarefa (detecção de AprilTag) ═══
         Adicionada em 2026-08-12 pra fechar o loop de percepção pedido
         pelo Marco: "a tag deve ser utilizada para aproximação do
         robot até a chave" — sem isso, task_sequencer.py só sabia onde
         a chave estava porque perguntava direto pro Gazebo
         (/gazebo/get_link_state, trapaça de ground-truth que nenhum
         robô real teria).

         NÃO é o T265 de novo — o t265_link continua sendo o único
         sensor de POSE do EE (VIO, arquitetura sem encoders,
         inalterado). Esta é uma câmera pinhole simples, proxy de
         simulação para o STREAM DE IMAGEM que a câmera fisheye do
         T265 real também forneceria (mesmo pipeline já validado com
         hardware real — ver memória project_fase4_apriltag_validacao:
         T265 real + AprilTag 36h11, regra tag≥d/11, tag física de
         132mm — mesmo tamanho usado aqui). Modelar o FOV fisheye real
         do T265 é desnecessário pra essa demonstração; pinhole padrão
         do Gazebo já resolve.

         Montada no mesmo ponto/direção do JTool (offset z=-0.08 a
         partir do GripCube, mesmo "para frente" que a ferramenta
         aponta) — olhando para onde o robô vai manipular.

         NOTA (2026-09-02): a justificativa original era que o T265
         apontava para outro lado (a "rotação tortuosa" rpy="0 2.1 1.57").
         Isso deixou de valer: remontado nos furos do berço de cima, o
         T265 olha reto para -Z, a MESMA direção desta câmera. O que
         separa as duas hoje é só o sensor — fisheye equidistante contra
         pinhole — e esta continua não existindo na bancada. ═══ -->
    <joint name="JTaskCamera" type="fixed">
      <origin xyz="0 0 -0.08" rpy="0 0 0"/>
      <parent link="GripCube"/>
      <child link="task_camera_link"/>
    </joint>

    <link name="task_camera_link">
      <!-- Corpo da câmera, deslocado para FORA da geometria do gripper.
           Antes ficava na mesma origem do GripCube e sumia dentro dele
           (o Marco: "a câmera não é visível na simulação") — o sensor
           funcionava, mas não dava para ver onde estava nem para onde
           apontava. O deslocamento é só VISUAL: o frame óptico, que é
           o que importa para o PnP, continua na origem do link. -->
      <visual>
        <origin xyz="-0.03 0 0.035" rpy="0 0 0"/>
        <geometry><box size="0.05 0.045 0.03"/></geometry>
        <material name="CameraBody"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <!-- Lente, apontando ao longo do eixo óptico (+X do link) -->
      <visual>
        <origin xyz="0.005 0 0.035" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.013" length="0.02"/></geometry>
        <material name="CameraLens"><color rgba="0.15 0.3 0.55 1"/></material>
      </visual>
    </link>

    <gazebo reference="task_camera_link">
      <material>Gazebo/Blue</material>
      <sensor type="camera" name="task_camera">
        <update_rate>15.0</update_rate>
        <camera>
          <!-- FOV largo (~86°) — compensar não ter as duas câmeras
               fisheye do T265 real, que juntas cobrem bem mais campo. -->
          <horizontal_fov>1.5</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>15.0</far></clip>
        </camera>
        <plugin name="task_camera_controller" filename="libgazebo_ros_camera.so">
          <cameraName>task_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>task_camera_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

    <joint name="JGripCube" type="fixed">
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <parent link="CameraSupport"/>
      <child link="GripCube"/>
    </joint>

    <link name="GripCube">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.57 0" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/GripCube.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="GripCubeColor">
          <color rgba="0.25 0.25 0.25 1"/>
        </material>
      </visual>
    </link>

    <joint name="JGrip1" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="GripCube"/>
      <child link="Grip1"/>
    </joint>

    <!-- Grip2 REMOVIDO em 2026-08-27.

         Nas fotos da bancada (IMG_0593 / IMG_0599, 2026-08-26) só UMA
         das castanhas da HM-01 tem dedo montado — é nela que a placa em
         L do dedo fixo é parafusada (4 parafusos, grade 2x2). A castanha
         oposta está NUA, apenas com os furos roscados à vista.

         O modelo mantinha os dois meshes originais, então a simulação
         desenhava um dedo azul em −X que não existe no robô. Como a
         garra não abre nem fecha na tarefa (ver o bloco do DEDO FIXO
         abaixo), esse dedo é massa e geometria fantasma: some daqui.

         Grip1 (em +0.03, mesma origem do JTool) fica: é a lingueta que o
         garfo do dedo fixo abraça. -->

    <link name="Grip1">
      <visual>
        <origin xyz="0.03 0 -0.08" rpy="0 1.57 -1.57" />
        <geometry>
          <mesh filename="package://movemaster_control/3D_Models/Grip1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="L1Color">
          <color rgba="0.15 0.2 0.8 1"/>
        </material>
      </visual>
    </link>

    <!-- ═══ Ferramenta de operação (vara rígida + gancho na ponta) ═══
         Decisão do Marco (2026-08-12): vara rígida (sem junta própria,
         sem atuação — só extensão fixa do EE), 20cm de comprimento
         (reduzida de 35cm por pedido do Marco em 2026-08-13),
         com gancho na ponta pra engatar no olhal da chave seccionadora
         (ver urdf/fixtures/chave_seccionadora_lf.urdf.xacro). Existe
         pra dar folga real entre o chassi/braço e a parede — o RV-M2
         sozinho (~0,5-0,7m de alcance) força a base a chegar quase
         colada na parede pra alcançar o olhal, o que já derrubou o
         robô numa simulação de teste (base colidindo com a parede).
         Mesma lógica de uma vara de manobra real (hot stick): manter
         distância do ponto energizado.

         Montada no mesmo ponto que o gripper visual (GripCube, ponta
         em z=-0.08 no frame do GripCube, mesmo offset dos meshes
         Grip1) — SEM junta própria (fixed), então herda a fusão
         de corpo rígido do Gazebo junto com L5/CameraSupport/GripCube
         (mesmo comportamento já documentado nas fixtures: um
         <gazebo reference> por link, não <material><color> puro).

         IMPORTANTE: o T265 (t265_link) continua sendo o único sensor
         de pose do EE (arquitetura sem encoders) — a ponta da
         ferramenta (tool_tip) NÃO é observada diretamente, é um offset
         FIXO e conhecido a partir de t265_link (mesmo CameraSupport
         rígido). Ver kinematics.py (T_T265_TOOLTIP) para essa
         transformação — quem consome alvos Cartesianos pensando na
         ponta da ferramenta (ex.: task_sequencer.py) precisa aplicar
         esse offset ao comandar o T265, não pode simplesmente mirar a
         ponta da ferramenta como se fosse o EE controlado. ═══ -->
    <!-- ═══════════════════════════════════════════════════════════════
         DEDO FIXO — ferramenta de manobra do Marco (desenho de
         2026-08-25, Dedo_Fixo_RVM2_desenho.png).

         Substitui os DEDOS do gripper, não o gripper: o garfo abraça a
         lingueta original de 10 mm (vão 10,4 mm, 4 furos M3 por aba em
         grade 2x2) e a garra não abre nem fecha durante a tarefa — ela
         só transmite tração. Isso elimina o grau de liberdade que não
         temos como controlar bem e transforma a garra num ponto de
         ancoragem rígido.

         Geometria (mm), ao longo de -Z a partir da montagem — REVISADA
         em 2026-09-02 com o Marco (ver o bloco de propriedades abaixo):
           garfo   25 de altura, 20 x 25 de seção, abas de 10
           afunil. 10, RAMPA de 20 x 25 para 10 x 10 (inclinada, sem
                   canto vivo — o bloco 15 x 22 que estava aqui era erro
                   de modelagem meu, a peça é uma transição contínua)
           haste   80, seção 10 x 10
           degrau  10 de altura, 10 de largura, 20 de projeção em -X
           total  125

         A ponta alargada é o que prende o elo: a haste de 10,4 mm passa
         pelo olhal, e o degrau de 20 mm (30,4 − 10,4) impede o anel de
         escapar quando o conjunto traciona. É o mesmo princípio do
         gancho de vara de manobra convencional, que o Marco descreveu
         como "gancho puxando um elo".

         POR QUE ISTO SUBSTITUI O GANCHO EM J ANTERIOR: aquele tinha
         quatro cilindros de VISUAL e UMA ESFERA de colisão. Uma esfera
         não engata nada — empurra e escorrega. Foi por isso que a
         primeira tentativa de abertura por contato terminou com a ponta
         a 2,8 mm do alvo e a lâmina cravada em 0,0°: a trajetória
         estava certa e não havia geometria para prender. Aqui cada
         trecho tem colisão de caixa, com a mesma forma do visual.
         ═══════════════════════════════════════════════════════════════ -->
    <!-- Geometria do desenho (mm). A peça é um L: a haste sai do garfo
         e o DEGRAU vira 90° no plano perpendicular a ela.

         Corrigido em 2026-08-26 depois de o Marco apontar que a vista
         superior do desenho é um L, não uma barra com um bloco. Eu vinha
         lendo a vista superior como se fosse lateral e modelei o degrau
         como um poste vertical. Ele é um DEDO HORIZONTAL — e só assim
         atravessa um anel cujo furo olha para o lado (normal em X). -->
    <xacro:property name="dedo_garfo_h"  value="0.025"/>
    <xacro:property name="dedo_afun_h"   value="0.010"/>
    <xacro:property name="dedo_haste_l"  value="0.080"/>
    <!-- SEÇÃO 10 x 10 (2026-09-02). O Marco reduziu a haste e o degrau
         no plano Y de 20 para 10 mm — "teremos uma haste 10 mm x 10 mm, e
         o degrau vai acompanhar essa medida também", altura do degrau
         inclusive. Os 10,4 em X eram escolha minha (lingueta de 10 +
         folga); "10 ou 10,4 não fará muita diferença", então 10.

         O QUE ISSO COMPRA: o degrau era 20 x 17 num oval de 30 x 40, e
         a ROLAGEM em torno do próprio eixo decidia se ele passava — além
         de ~20° o canto saía do contorno (foi isso que fixou a distância
         de engate em 0,54 contra 0,62, ver chave_mission.py). Um 10 x 10
         tem diagonal de 14,1 mm: cabe no vão de 30 em QUALQUER rolagem.
         A restrição que mandava na tarefa deixa de existir.

         O QUE CUSTA: rigidez à flexão no plano Y cai por 8 (I ∝ h³), e a
         face de apoio do arame encurta de 20 para 10 mm. -->
    <xacro:property name="dedo_haste_x"  value="0.010"/>
    <xacro:property name="dedo_haste_y"  value="0.010"/>
    <!-- Projeção do degrau além da haste: 20 mm, inalterada. É o
         comprimento útil que fica atravessado no furo e sustenta o
         arame do olhal. -->
    <xacro:property name="dedo_degrau_l" value="0.020"/>
    <xacro:property name="dedo_degrau_z" value="0.010"/>

    <xacro:property name="tool_length"
                    value="${dedo_garfo_h + dedo_afun_h + dedo_haste_l}"/>

    <joint name="JTool" type="fixed">
      <origin xyz="0.03 0 -0.08" rpy="0 0 0"/>
      <parent link="GripCube"/>
      <child link="tool_rod"/>
    </joint>

    <link name="tool_rod">
      <visual>
        <origin xyz="0 0 ${-dedo_garfo_h/2}"/>
        <geometry><box size="0.020 0.025 ${dedo_garfo_h}"/></geometry>
        <material name="ToolColor"><color rgba="0.85 0.75 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${-dedo_garfo_h/2}"/>
        <geometry><box size="0.020 0.025 ${dedo_garfo_h}"/></geometry>
      </collision>
      <!-- AFUNILAMENTO INCLINADO. Tronco de pirâmide gerado em código
           (meshes/movemaster/dedo_afunilamento.stl, em METROS, já no
           frame deste link: topo 20 x 25 em z = -0,025, base 10 x 10 em
           z = -0,035). Se dedo_garfo_h ou dedo_afun_h mudarem, a malha
           tem que ser regerada — ela não lê as propriedades.

           A colisão fica como CAIXA 10 x 10, a seção menor: a rampa
           nunca encosta em nada (fica 90 mm acima do degrau), e caixa é
           mais barata e mais estável no ODE que trimesh. -->
      <visual>
        <origin xyz="0 0 0"/>
        <geometry><mesh filename="package://b166er_robot/meshes/movemaster/dedo_afunilamento.stl"/></geometry>
        <material name="ToolColor"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-dedo_garfo_h - dedo_afun_h/2}"/>
        <geometry><box size="${dedo_haste_x} ${dedo_haste_y} ${dedo_afun_h}"/></geometry>
      </collision>
      <visual>
        <origin xyz="0 0 ${-dedo_garfo_h - dedo_afun_h - dedo_haste_l/2}"/>
        <geometry><box size="${dedo_haste_x} ${dedo_haste_y} ${dedo_haste_l}"/></geometry>
        <material name="ToolColor"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-dedo_garfo_h - dedo_afun_h - dedo_haste_l/2}"/>
        <geometry><box size="${dedo_haste_x} ${dedo_haste_y} ${dedo_haste_l}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.12"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="JToolTip" type="fixed">
      <origin xyz="0 0 ${-tool_length}" rpy="0 0 0"/>
      <parent link="tool_rod"/>
      <child link="tool_tip"/>
    </joint>

    <!-- DEGRAU — o dedo horizontal que atravessa o olhal.
         Sai em −X a partir do eixo da haste; girando J5 a peça aponta
         para a direita ou para a esquerda, como o Marco descreveu.

         A ORIGEM DESTE LINK é a referência da tarefa: é aqui que o
         arame do anel repousa depois da descida de 5 mm. -->
    <link name="tool_tip">
      <visual>
        <origin xyz="${-dedo_degrau_l/2} 0 ${-dedo_degrau_z/2}"/>
        <geometry><box size="${dedo_degrau_l + dedo_haste_x} ${dedo_haste_y} ${dedo_degrau_z}"/></geometry>
        <material name="ToolColor"><color rgba="0.85 0.75 0.1 1"/></material>
      </visual>
      <!-- COLISÃO SÓ DA PARTE QUE SE PROJETA, não da largura visual.
           A caixa visual acima vai de x=+5,2 mm a x=-25,2 mm para
           desenhar o L inteiro — mas isso faz ela compartilhar uma FACE
           inteira (z=0, de x=-5,2 a +5,2) com a haste do tool_rod. Duas
           faces coincidentes no mesmo corpo rígido geram contato
           permanentemente: a captura de 2026-08-27 registrou 1,1 MILHÃO
           de pares tool_rod x tool_tip em ~90 s de simulação, e é o
           suspeito do travamento do J1 numa execução anterior (J1
           comandado subindo, medido parado, defasagem crescendo até 16°
           enquanto J2..J5 seguiam dentro de 1°).

           Aqui a caixa começa onde a haste termina, com 0,5 mm de
           recuo, de modo que os dois sólidos se encostem no máximo por
           uma aresta. A face SUPERIOR do degrau (z=0) é preservada
           porque é ela que sustenta o arame do anel. -->
      <xacro:property name="degrau_gap" value="0.0005"/>
      <collision>
        <origin xyz="${-(dedo_degrau_l/2 + dedo_haste_x/2 + degrau_gap)} 0 ${-dedo_degrau_z/2}"/>
        <geometry><box size="${dedo_degrau_l} ${dedo_haste_y} ${dedo_degrau_z}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.04"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <gazebo reference="tool_rod"><material>Gazebo/Yellow</material></gazebo>
    <gazebo reference="tool_tip"><material>Gazebo/Yellow</material></gazebo>

    <!-- T265 em VERDE no Gazebo (pedido do Marco, 2026-09-02). O
         <material> do URDF, logo acima no t265_link, vale só para o
         RViz; o Gazebo ignora e usa este bloco. Em cinza escuro a
         câmera se confundia com o corpo do punho nas capturas de tela,
         que é como acompanhamos a manipulação. Verde e não laranja
         porque a haste e o degrau já são amarelos: laranja ficava perto
         demais deles na paleta, e o que precisa se distinguir é
         justamente câmera x ferramenta. -->
    <gazebo reference="t265_link"><material>Gazebo/Green</material></gazebo>

    <xacro:macro name="arm_transmission" params="joint_name">
      <transmission name="${joint_name}_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="${joint_name}">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="${joint_name}_motor">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
        </actuator>
      </transmission>
    </xacro:macro>

    <xacro:arm_transmission joint_name="J1"/>
    <xacro:arm_transmission joint_name="J2"/>
    <xacro:arm_transmission joint_name="J3"/>
    <xacro:arm_transmission joint_name="J4"/>
    <xacro:arm_transmission joint_name="J5"/>

    <!-- Plugin gazebo_ros_control para ativar as transmissões acima -->
    <gazebo>
      <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <robotNamespace>/</robotNamespace>
        <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
