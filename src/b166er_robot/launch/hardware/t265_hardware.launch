<launch>
  <!-- Intel RealSense T265 Tracking Camera -->
  <!-- Delega ao launch oficial do realsense2_camera (nodelet) -->
  <!-- Publica: /t265/odom/sample, /t265/accel/sample, /t265/gyro/sample -->

  <arg name="camera"          default="t265"/>
  <arg name="serial_no"       default=""/>
  <arg name="publish_odom_tf" default="true"/>

  <include file="$(find realsense2_camera)/launch/rs_t265.launch">
    <arg name="camera"          value="$(arg camera)"/>
    <arg name="serial_no"       value="$(arg serial_no)"/>
    <arg name="enable_pose"     value="true"/>
    <arg name="enable_accel"    value="true"/>
    <arg name="enable_gyro"     value="true"/>
    <!-- FISHEYE LIGADAS (2026-08-25): no robô real elas são a ÚNICA
         câmera disponível. A câmera de tarefa do URDF só existe na
         simulação. O AprilTag da chave é detectado a partir daqui — ver
         apriltag_localizer, parâmetro ~fisheye. -->
    <arg name="enable_fisheye1" value="true"/>
    <arg name="enable_fisheye2" value="false"/>   <!-- uma basta para o PnP monocular -->
    <arg name="publish_odom_tf" value="$(arg publish_odom_tf)"/>
  </include>
</launch>
