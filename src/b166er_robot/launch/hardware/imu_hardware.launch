<launch>
  <!-- Sparton AHRS-8 — porta fixada por udev em /dev/sparton/ahrs8, que
       é o symlink que a regra do próprio driver cria
       (sparton_ahrs8_driver/udev/51-sparton-ahrs8.rules, por serial do
       FTDI, MODE 0666). Dizia /dev/ttyAHRS, que nenhuma regra criava
       (2026-09-10). Instalar a regra: copiar para /etc/udev/rules.d/. -->
  <arg name="port"         default="/dev/sparton/ahrs8"/>
  <arg name="baud"         default="115200"/>
  <arg name="frame_id"     default="ahrs8"/>
  <arg name="polling_rate" default="10"/>

  <include file="$(find sparton_ahrs8_driver)/launch/ahrs-8.launch">
    <arg name="port"         value="$(arg port)"/>
    <arg name="baud"         value="$(arg baud)"/>
    <arg name="frame_id"     value="$(arg frame_id)"/>
    <arg name="polling_rate" value="$(arg polling_rate)"/>
  </include>
</launch>
