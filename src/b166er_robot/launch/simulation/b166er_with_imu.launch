<launch>
  
  <!-- Robot Description -->
  <param name="robot_description" command="$(find xacro)/xacro $(find b166er_robot)/urdf/pioneer3at/pioneer3at.urdf"/>

  <!-- Robot State Publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- IMU Driver - Check what launch file actually exists -->
  <!-- <include file="$(find sparton_ahrs8_driver)/launch/AHRS-8.launch"/> -->
  <!-- Or maybe it's: -->
  <!-- <include file="$(find sparton_ahrs8_driver)/launch/sparton_ahrs8.launch"/> -->
  
  <!-- Transform from robot base to IMU -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_imu_broadcaster" 
        args="0 0 0.234 0 0 0 base_link ahrs8_imu" respawn="true"/>

  <!-- Joint State Publisher -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui"/>

  <!-- IMU Monitor -->
  <node name="imu_monitor" pkg="b166er_robot" type="imu_monitor.py" output="screen">
    <param name="print_interval" value="2.0"/>
  </node>

  <!-- Stability Controller -->
  <node name="stability_controller" pkg="b166er_robot" type="stability_controller.py" output="screen">
    <param name="max_tilt_angle" value="0.3"/>
  </node>

</launch>