<launch>
  <!-- Robot model parameter -->
  <param name="robot_description" command="$(find xacro)/xacro $(find b166er_robot)/urdf/combined/pioneer_movemaster.urdf"/>

  <!-- Robot state publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- Joint state publisher GUI for manual control -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui"/>

  <!-- RViz with software rendering -->
  <node name="rviz" pkg="rviz" type="rviz" 
        launch-prefix="env LIBGL_ALWAYS_SOFTWARE=1 OGRE_RTT_MODE=Copy"/>

</launch>