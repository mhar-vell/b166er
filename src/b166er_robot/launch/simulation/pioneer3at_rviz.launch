<launch>
  <!-- Robot model parameter -->
  <param name="robot_description" command="$(find xacro)/xacro $(find b166er_robot)/urdf/pioneer/pioneer/pioneer3at_original.urdf"/>

  <!-- Robot state publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- Joint state publisher GUI for manual control -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui"/>

  <!-- RViz without custom config -->
  <node name="rviz" pkg="rviz" type="rviz" />

  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find b166er_robot)/config/pioneer_movemaster.rviz"/> -->

    <!-- RViz with software rendering -->
  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find b166er_robot)/config/pioneer_movemaster.rviz" 
        launch-prefix="env LIBGL_ALWAYS_SOFTWARE=1 OGRE_RTT_MODE=Copy"/> -->

</launch>