<launch>

  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro $(find b166er_robot)/urdf/pioneer3at/pioneer3at_gazebo.urdf.xacro"/>

  <!-- Robot state publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- Start Gazebo with empty world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find b166er_robot)/worlds/pioneer_test.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Spawn robot in Gazebo -->
  <node name="spawn_pioneer" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -model pioneer3at -param robot_description -x 0 -y 0 -z 0.1"/>

  <!-- IMU Monitor -->
  <node name="imu_monitor" pkg="b166er_robot" type="imu_monitor.py" output="screen">
    <param name="print_interval" value="2.0"/>
  </node>

  <!-- Stability Controller -->
  <node name="stability_controller" pkg="b166er_robot" type="stability_controller.py" output="screen">
    <param name="max_tilt_angle" value="0.3"/>
    <remap from="/cmd_vel_raw" to="/cmd_vel"/>
    <remap from="/cmd_vel_filtered" to="/cmd_vel_safe"/>
  </node>

  <!-- RViz -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find b166er_robot)/config/gazebo_simulation.rviz"/>

</launch>